# Copy to .env and fill in. .env is gitignored and must stay that way —
# this repository is public.

# Cloudflare account that owns caraka.dev. Deploy reads it from the
# environment so no account identifier is committed.
CLOUDFLARE_ACCOUNT_ID=

# Only needed for non-interactive deploys (CI). A local `wrangler login`
# covers interactive use and stores nothing in this repo.
CLOUDFLARE_API_TOKEN=
