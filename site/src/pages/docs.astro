---
// Ported from design/mockups/Caraka Docs.dc.html. Markup and inline styles are
// transcribed as-is; see site/AGENTS.md for the substitutions that replace the
// design-comp runtime.
import Base from '../layouts/Base.astro'
import '../styles/pages/docs.css'
import { chapters } from '../data/docs'
import MobileMenu from '../components/MobileMenu.astro'
import MobileToc from '../components/MobileToc.astro'
---

<Base page="docs">
  <div style="width: 100%; background: #05080C; font-family: 'Public Sans', sans-serif; color: #E9EDF2; position: relative; overflow-x: hidden;">

    <div style="position: fixed; left: 0; top: 0; right: 0; height: 2px; z-index: 110; background: #171C22;">
      <div style="height: 100%; width: 100%; background: linear-gradient(90deg, #E2452C, #FF7A5E); transform-origin: left; transform: scaleX(var(--ck-sp, 0));"></div>
    </div>

    <header style="position: fixed; left: 0; right: 0; top: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 14px clamp(16px, 4vw, 34px); background: rgba(5,8,12,.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid #0C1116;">
      <a href="/" style="display: flex; align-items: center; gap: 12px;">
        <span style="position: relative; width: 44px; height: 22px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <span style="position: absolute; left: 50%; top: 50%; width: 21px; height: 21px; margin: -10.5px 0 0 -21px; border-radius: 50%; border: 1px solid #E2452C;"></span>
          <span style="position: absolute; left: 50%; top: 50%; width: 21px; height: 21px; margin: -10.5px 0 0 0; border-radius: 50%; border: 1px solid #E2452C;"></span>
          <span style="position: relative; font-family: 'Noto Sans Javanese', serif; font-size: 12px; line-height: 1; display: block; transform: translateY(17.5%); color: #F6F9FC;">ꦕ</span>
        </span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .2em; color: #E9EDF2;">caraka</span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .16em; color: #E2452C; padding: 3px 8px; border: 1px solid #2B1612; border-radius: 5px;">DOCS</span>
      </a>
      <nav data-navlinks="1" style="display: flex; align-items: center; gap: clamp(14px, 2.4vw, 26px); font-family: 'JetBrains Mono', monospace; font-size: 12px;">
        <a href="/" class="hv-ink" style="color: #7A848F;">Home</a>
        <a href="/compare" class="hv-ink" style="color: #7A848F;">Compare</a>
        <a href="/install" class="hv-ink" style="color: #7A848F;">Install</a>
        <a href="/story" class="hv-ink" style="color: #7A848F;">Story</a>
      </nav>
      <a href="https://github.com/CarakaDev/caraka" class="hv-ring-ink" style="padding: 9px 16px; border: 1px solid #292E35; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #B2BCC6; transition: border-color .2s, color .2s; white-space: nowrap;">GitHub ↗</a>
      <MobileMenu links={[{ label: 'Home', href: '/' }, { label: 'Compare', href: '/compare' }, { label: 'Install', href: '/install' }, { label: 'Story', href: '/story' }]} cta={{ label: 'GitHub ↗', href: 'https://github.com/CarakaDev/caraka' }} />
    </header>

    <div style="display: flex; gap: clamp(30px, 5vw, 66px); width: min(1240px, 100%); margin: 0 auto; padding: clamp(96px, 14vh, 130px) clamp(20px, 5vw, 48px) clamp(70px, 12vh, 120px);">

      <main id="main" style="flex: 1; min-width: 0;">
        <MobileToc chapters={chapters} breakpoint={1040} />


        <div style="margin-bottom: clamp(40px, 6vh, 62px); animation: ck-boot .8s cubic-bezier(.2,.9,.3,1) both;">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">DOCUMENTATION</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX 1s cubic-bezier(.3,.7,.3,1) .2s both;"></span>
          </div>
          <h1 style="margin: 0 0 16px; font-size: clamp(30px, 5.2vw, 52px); font-weight: 700; letter-spacing: -.03em; line-height: 1.08; color: #F6F9FC; text-wrap: balance;">Everything Caraka does, and what it deliberately doesn't.</h1>
          <p style="margin: 0; max-width: 640px; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty;">Caraka is a bridge, not an agent. It has no reasoning loop, no execution tools, no model provider, and no plugin marketplace — your coding agent already has all of those, in better form.</p>
          <div style="display: flex; align-items: center; gap: 10px; margin-top: 22px; padding: 13px 18px; background: #12100F; border: 1px solid #2B1612; border-radius: 10px; font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: #E0B4A8; max-width: 640px;">
            <span style="color: #FFD67E;">⏸</span>
            <span><strong style="color: #F6F9FC; font-weight: 600;">v0.1 preview.</strong> Private Telegram DM to Claude Code is usable now. Memory, groups, services, attachments, and other agents remain roadmap work.</span>
          </div>
        </div>

        {chapters.map((c) => (
          <section id={c.id} style="margin-bottom: clamp(48px, 8vh, 84px); scroll-margin-top: 90px;">
            <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 12px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 80%;">
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #E2452C;">{c.no}</span>
              <h2 style="margin: 0; font-size: clamp(21px, 3vw, 29px); font-weight: 700; letter-spacing: -.02em; color: #F6F9FC; text-wrap: balance;">{c.title}</h2>
            </div>
            <p style="margin: 0 0 24px; max-width: 660px; font-size: 15.5px; line-height: 1.72; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 24%;">{c.intro}</p>

            {c.term && (
              <div style="position: relative; background: #05070A; border: 1px solid #171C22; border-radius: 13px; padding: clamp(18px, 2.5vw, 26px); margin-bottom: 24px; font-family: 'JetBrains Mono', monospace; font-size: clamp(11.5px, 1.4vw, 13px); line-height: 1.95; overflow-x: auto; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">
                <div style="position: absolute; left: 0; right: 0; top: 0; height: 1px; background: linear-gradient(90deg, transparent, #E2452C, transparent); opacity: .45;"></div>
                {c.term.map((l) => (
                  <div style={`display: flex; gap: 9px; color: ${l.tone}; white-space: pre;`}>{l.mark && (<span style={`color: ${l.markTone};`}>{l.mark}</span>)}<span>{l.t}</span></div>
                ))}
              </div>
            )}

            {c.rows && (
              <div style="border: 1px solid #171C22; border-radius: 13px; overflow: hidden; margin-bottom: 24px; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">
                {c.rows.map((r) => (
                  <div class="hv-row" style="display: flex; flex-wrap: wrap; gap: 6px 18px; padding: 14px 18px; border-bottom: 1px solid #171C22; background: #0C1116; transition: background .2s;">
                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: #FF7A5E; min-width: 190px; flex-shrink: 0;">{r.k}</span>
                    <span style="flex: 1; min-width: 200px; font-size: 14px; line-height: 1.55; color: #95A0AB; text-wrap: pretty;">{r.v}</span>
                  </div>
                ))}
              </div>
            )}

            {c.cards && (
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; margin-bottom: 24px;">
                {c.cards.map((d) => (
                  <div style={`padding: 22px 24px; background: ${d.bg}; border: 1px solid ${d.border}; border-radius: 13px; display: flex; flex-direction: column; gap: 9px; animation: ck-riseSm linear both; animation-timeline: view(); animation-range: ${d.range};`}>
                    <span style={`font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .18em; color: ${d.tone};`}>{d.tag}</span>
                    <span style="font-size: 16px; font-weight: 600; color: #F6F9FC; text-wrap: pretty;">{d.title}</span>
                    <span style="font-size: 13.5px; line-height: 1.6; color: #7A848F; text-wrap: pretty;">{d.body}</span>
                  </div>
                ))}
              </div>
            )}

            {c.note && (
              <div style="display: flex; gap: 13px; padding: 17px 20px; background: #12100F; border-left: 2px solid #E2452C; border-radius: 0 10px 10px 0; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">
                <span style="color: #FF7A5E; font-family: 'JetBrains Mono', monospace; font-size: 13px; flex-shrink: 0;">!</span>
                <span style="font-size: 14px; line-height: 1.65; color: #E0B4A8; text-wrap: pretty;">{c.note}</span>
              </div>
            )}
          </section>
        ))}

        <div style="padding: clamp(30px, 5vw, 44px); background: #0C1116; border: 1px solid #171C22; border-radius: 16px; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 30%;">
          <div>
            <div style="font-size: 19px; font-weight: 600; color: #F6F9FC; margin-bottom: 7px;">The spec is public, in full.</div>
            <div style="font-size: 14px; line-height: 1.6; color: #7A848F; max-width: 420px; text-wrap: pretty;">Nine research documents with sources, plus PRD, FRD, architecture, ERD, security model, and roadmap.</div>
          </div>
          <a href="https://github.com/CarakaDev/caraka" class="hv-btn" style="padding: 14px 24px; background: #E2452C; border-radius: 10px; font-family: 'JetBrains Mono', monospace; font-size: 13.5px; color: #FFEDE7; white-space: nowrap; transition: background .2s;">Browse the repo →</a>
        </div>
      </main>

      <aside data-toc="1" style="width: 208px; flex-shrink: 0;">
        <div style="position: sticky; top: 104px; display: flex; flex-direction: column; gap: 3px;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .2em; color: #414950; margin-bottom: 12px;">ON THIS PAGE</div>
          {chapters.map((c) => (
            <a href={c.href} class="hv-ring-ink" style="display: flex; align-items: baseline; gap: 10px; padding: 7px 0 7px 12px; border-left: 1px solid #171C22; font-size: 13px; color: #7A848F; transition: color .2s, border-color .2s;">
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #414950;">{c.no}</span>
              <span style="text-wrap: pretty;">{c.title}</span>
            </a>
          ))}
        </div>
      </aside>
    </div>

    <footer style="padding: clamp(44px, 7vh, 70px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1240px, 100%); margin: 0 auto; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #414950;">ꦕ caraka · MIT · v0.1 preview</span>
        <div style="display: flex; flex-wrap: wrap; gap: clamp(14px, 2.6vw, 28px); font-family: 'JetBrains Mono', monospace; font-size: 12.5px;">
          <a href="/" class="hv-ink" style="color: #7A848F;">Home</a>
          <a href="/story" class="hv-ink" style="color: #7A848F;">Story</a>
          <a href="/security" class="hv-ink" style="color: #7A848F;">Security</a>
          <a href="/status" class="hv-ink" style="color: #7A848F;">Status</a>
          <a href="https://github.com/CarakaDev/caraka" class="hv-ink" style="color: #7A848F;">GitHub</a>
          <a href="mailto:halo@caraka.dev" class="hv-ink" style="color: #7A848F;">halo@caraka.dev</a>
        </div>
      </div>
    </footer>
  </div>
</Base>
