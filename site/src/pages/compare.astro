---
// Ported from design/mockups/Caraka Compare.dc.html. Markup and inline styles are
// transcribed as-is; see site/AGENTS.md for the substitutions that replace the
// design-comp runtime.
import Base from '../layouts/Base.astro'
import SiteHeader from '../components/SiteHeader.astro'
import '../styles/pages/compare.css'
import { products, rows, complaints, tokenPaths, picks, honest } from '../data/compare'
---

<Base page="compare">
  <div style="width: 100%; background: #05080C; font-family: 'Public Sans', sans-serif; color: #E9EDF2; position: relative; overflow-x: hidden;">

    <div style="position: fixed; left: 0; top: 0; right: 0; height: 2px; z-index: 110; background: #171C22;">
      <div style="height: 100%; width: 100%; background: linear-gradient(90deg, #E2452C, #FF7A5E); transform-origin: left; transform: scaleX(var(--ck-sp, 0));"></div>
    </div>

    <SiteHeader badge="COMPARE" active="/compare" />

    <main id="main">

    <section style="position: relative; padding: clamp(120px, 17vh, 180px) clamp(20px, 5vw, 60px) clamp(56px, 8vh, 90px);">
      <div style="width: min(1120px, 100%); margin: 0 auto;">
        <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; animation: ck-boot .8s cubic-bezier(.2,.9,.3,1) both;">
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">CARAKA vs OPENCLAW vs HERMES</span>
          <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX 1s cubic-bezier(.3,.7,.3,1) .25s both;"></span>
        </div>
        <h1 style="margin: 0 0 20px; max-width: 900px; font-size: clamp(30px, 5.6vw, 58px); font-weight: 700; letter-spacing: -.03em; line-height: 1.08; color: #F6F9FC; text-wrap: balance; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .15s both;">They are personal assistants that can also write code. Caraka only writes code.</h1>
        <p style="margin: 0 0 26px; max-width: 640px; font-size: clamp(15px, 1.9vw, 18px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .28s both;">This is not a fight over the same users. OpenClaw clears your inbox, keeps your calendar, and drives your browser. Writing code sits somewhere on that list. For Caraka it is the entire list.</p>
        <div style="display: flex; gap: 13px; padding: 17px 20px; max-width: 640px; background: #0C1116; border: 1px solid #171C22; border-radius: 11px; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .4s both;">
          <span style="color: #7A848F; font-size: 20px; line-height: 1; flex-shrink: 0;">&ldquo;</span>
          <div>
            <p style="margin: 0 0 7px; font-size: 15px; line-height: 1.6; color: #D2D8DF; text-wrap: pretty;">OpenClaw is a personal agent; OpenCode is a coding agent. Different tools for different jobs.</p>
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #5D666F;">Standard Compute, 2026</span>
          </div>
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(50px, 8vh, 80px) clamp(20px, 5vw, 60px) clamp(70px, 11vh, 120px);">
      <div style="width: min(1120px, 100%); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(14px, 2vw, 20px);">
        {products.map((p) => (
          <div style={`position: relative; padding: clamp(26px, 3.4vw, 36px); background: ${p.bg}; border: 1px solid ${p.border}; border-radius: 16px; display: flex; flex-direction: column; gap: 16px; animation: ck-rise linear both; animation-timeline: view(); animation-range: ${p.range};`}>
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span style="font-size: 21px; font-weight: 700; letter-spacing: -.02em; color: #F6F9FC;">{p.name}</span>
              {p.us && (
                <span aria-hidden="true" style="position: relative; width: 40px; height: 20px; display: flex; align-items: center; justify-content: center;">
                  <span style="position: absolute; left: 50%; top: 50%; width: 19px; height: 19px; margin: -9.5px 0 0 -19px; border-radius: 50%; border: 1px solid #E2452C;"></span>
                  <span style="position: absolute; left: 50%; top: 50%; width: 19px; height: 19px; margin: -9.5px 0 0 0; border-radius: 50%; border: 1px solid #E2452C;"></span>
                  <span style="position: absolute; left: 50%; top: 50%; width: 19px; height: 19px; margin: -9.5px 0 0 -19px; animation: ck-spin 3.6s linear infinite;"><span style="position: absolute; left: 100%; top: 50%; width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 50%; background: #FF7A5E;"></span></span>
                  <span style="position: absolute; left: 50%; top: 50%; width: 19px; height: 19px; margin: -9.5px 0 0 0; animation: ck-spinRev 3.6s linear infinite;"><span style="position: absolute; left: 0; top: 50%; width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 50%; background: #FF7A5E;"></span></span>
                </span>
              )}
            </div>
            <span style={`font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: .16em; color: ${p.tone};`}>{p.kind}</span>
            <p style="margin: 0; font-size: 14.5px; line-height: 1.65; color: #95A0AB; text-wrap: pretty;">{p.body}</p>
            <div style={`height: 1px; background: ${p.border};`}></div>
            <div style="display: flex; flex-direction: column; gap: 9px;">
              {p.does.map((d) => (
                <span style="display: flex; gap: 10px; font-size: 13.5px; line-height: 1.5; color: #7A848F;"><span style={`color: ${p.tone}; flex-shrink: 0;`}>·</span>{d}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section style="position: relative; padding: clamp(70px, 12vh, 130px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; background: #070A0E;">
      <div style="width: min(1120px, 100%); margin: 0 auto;">
        <div style="max-width: 700px; margin-bottom: clamp(30px, 4vh, 46px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 75%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">01 — SIDE BY SIDE</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0; font-size: clamp(25px, 4.2vw, 40px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Where the two shapes actually differ.</h2>
        </div>

        <div style="border: 1px solid #171C22; border-radius: 16px; overflow: hidden;">
          <div style="display: flex; padding: 14px clamp(14px, 2vw, 22px); background: #12100F; border-bottom: 1px solid #2B1612; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: .14em; color: #7A848F;">
            <span style="flex: 1.4; min-width: 110px;"></span>
            <span style="flex: 1; min-width: 84px;">OPENCLAW</span>
            <span style="flex: 1; min-width: 76px;">HERMES</span>
            <span style="flex: 1.2; min-width: 96px; color: #FF7A5E;">CARAKA</span>
          </div>
          {rows.map((r) => (
            <div class="hv-row" style={`display: flex; padding: 15px clamp(14px, 2vw, 22px); border-bottom: 1px solid #171C22; background: #0C1116; font-size: 13px; line-height: 1.5; transition: background .2s; animation: ck-riseSm linear both; animation-timeline: view(); animation-range: ${r.range};`}>
              <span style="flex: 1.4; min-width: 110px; color: #7A848F; padding-right: 10px;">{r.k}</span>
              <span style="flex: 1; min-width: 84px; color: #95A0AB; padding-right: 10px;">{r.a}</span>
              <span style="flex: 1; min-width: 76px; color: #95A0AB; padding-right: 10px;">{r.b}</span>
              <span style={`flex: 1.2; min-width: 96px; color: ${r.tone}; font-weight: ${r.weight};`}>{r.c}</span>
            </div>
          ))}
        </div>
        <p style="margin: 16px 0 0; font-size: 12.5px; line-height: 1.6; color: #5D666F; text-wrap: pretty;">Skywork measured usage distribution across both products and found 85% of OpenCode's usage is software development, while OpenClaw's spreads across personal use. The two products serve different people.</p>
      </div>
    </section>

    <section style="position: relative; padding: clamp(70px, 12vh, 130px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1120px, 100%); margin: 0 auto;">
        <div style="max-width: 720px; margin-bottom: clamp(32px, 4.5vh, 50px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 75%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">02 — WHAT USERS REPORTED</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0 0 16px; font-size: clamp(25px, 4.2vw, 40px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Six complaints that shaped this project.</h2>
          <p style="margin: 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">These come from a reviewer who used OpenClaw daily from January 2026 for both personal and professional work, and liked it enough to write at length before switching. Some may already be fixed. The dates are printed so you can judge.</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(288px, 1fr)); gap: clamp(14px, 2vw, 20px); align-items: stretch;">
          {complaints.map((c) => (
            <div class="hv-ring-soft" style={`padding: clamp(24px, 3vw, 30px); background: #0C1116; border: 1px solid #171C22; border-radius: 15px; display: flex; flex-direction: column; gap: 14px; transition: border-color .25s; animation: ck-rise linear both; animation-timeline: view(); animation-range: ${c.range};`}>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .18em; color: #FF93B2;">{c.tag}</span>
              <p style="margin: 0; font-size: 14.5px; line-height: 1.6; color: #D2D8DF; font-style: italic; text-wrap: pretty;">&ldquo;{c.quote}&rdquo;</p>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: #5D666F;">{c.src}</span>
              <div style="height: 1px; background: #171C22; margin-top: auto;"></div>
              <div style="display: flex; gap: 11px;">
                <span style="color: #8EEE98; font-family: 'JetBrains Mono', monospace; font-size: 12px; flex-shrink: 0; padding-top: 2px;">→</span>
                <span style="font-size: 14px; line-height: 1.6; color: #95A0AB; text-wrap: pretty;">{c.answer}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(70px, 12vh, 130px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; background: #070A0E;">
      <div style="width: min(1000px, 100%); margin: 0 auto;">
        <div style="max-width: 700px; margin-bottom: clamp(30px, 4vh, 44px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 75%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">03 — THE TOKEN MATH</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0 0 16px; font-size: clamp(25px, 4.2vw, 40px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">An assistant with its own loop bills you twice.</h2>
          <p style="margin: 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">This is the clearest economic difference, and it follows directly from architecture rather than pricing policy.</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(14px, 2vw, 20px);">
          {tokenPaths.map((t) => (
            <div style={`padding: clamp(24px, 3vw, 32px); background: ${t.bg}; border: 1px solid ${t.border}; border-radius: 15px; display: flex; flex-direction: column; gap: 14px; animation: ck-rise linear both; animation-timeline: view(); animation-range: ${t.range};`}>
              <span style={`font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .18em; color: ${t.tone};`}>{t.tag}</span>
              <div style="display: flex; flex-direction: column; gap: 10px; font-family: 'JetBrains Mono', monospace; font-size: 12.5px;">
                {t.steps.map((s) => (
                  <div style="display: flex; align-items: center; gap: 11px;">
                    <span style={`width: 7px; height: 7px; border-radius: 50%; background: ${s.dot}; flex-shrink: 0;`}></span>
                    <span style="color: #B2BCC6;">{s.t}</span>
                    <span style={`margin-left: auto; color: ${s.costTone};`}>{s.cost}</span>
                  </div>
                ))}
              </div>
              <div style={`height: 1px; background: ${t.border};`}></div>
              <span style="font-size: 14px; line-height: 1.6; color: #95A0AB; text-wrap: pretty;">{t.note}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(70px, 12vh, 140px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1000px, 100%); margin: 0 auto;">
        <div style="max-width: 700px; margin-bottom: clamp(30px, 4vh, 46px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 75%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">04 — WHICH ONE</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0; font-size: clamp(25px, 4.2vw, 40px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Pick by the job, not by the feature count.</h2>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          {picks.map((p) => (
            <div class="hv-ring-soft" style={`display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: center; padding: clamp(18px, 2.4vw, 24px); background: #0C1116; border: 1px solid ${p.border}; border-radius: 13px; transition: border-color .25s; animation: ck-riseSm linear both; animation-timeline: view(); animation-range: ${p.range};`}>
              <span style="flex: 1; min-width: 240px; font-size: 15px; line-height: 1.55; color: #B2BCC6; text-wrap: pretty;">{p.want}</span>
              <span style={`padding: 7px 15px; border-radius: 100px; background: ${p.chipBg}; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: ${p.chipInk}; white-space: nowrap;`}>{p.use}</span>
            </div>
          ))}
        </div>
        <div style="margin-top: clamp(26px, 4vh, 40px); padding: clamp(24px, 3.4vw, 36px); background: #12100F; border: 1px solid #2B1612; border-radius: 16px; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 30%;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .2em; color: #FF7A5E; margin-bottom: 16px;">WHAT WE WILL NOT CLAIM</div>
          <div style="display: flex; flex-direction: column; gap: 13px;">
            {honest.map((h) => (
              <div style="display: flex; gap: 12px;">
                <span style="color: #7A848F; font-family: 'JetBrains Mono', monospace; font-size: 12px; flex-shrink: 0; padding-top: 2px;">·</span>
                <span style="font-size: 14.5px; line-height: 1.65; color: #B2BCC6; text-wrap: pretty;">{h}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(70px, 12vh, 140px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; overflow: hidden;">
      <div aria-hidden="true" style="position: absolute; left: 50%; top: 50%; width: min(700px, 118vw); height: min(700px, 118vw); margin-left: min(-350px, -59vw); margin-top: min(-350px, -59vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.12), transparent 62%); pointer-events: none;"></div>
      <div style="position: relative; width: min(660px, 100%); margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 22px;">
        <h2 style="margin: 0; font-size: clamp(24px, 4.2vw, 40px); font-weight: 700; letter-spacing: -.03em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 28%;">Send the task. Caraka runs it.</h2>
        {/* Comp line 226 offers the Gemini free path. A gemini preset ships since v0.4, and its flags are transcribed from research rather than run here, so the sentence names both halves (presets/agents/gemini.yaml, CHANGELOG 0.4.0). */}
        <p style="margin: 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">v1.0 carries the task to whichever of the seven presets you point it at. Four have been run here; the free Gemini CLI path is a preset nobody has proven yet. Caraka itself never asks for a card.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 8% cover 34%;">
          <button type="button" data-copy="npx caraka init" class="hv-ring" style="display: flex; align-items: center; gap: 14px; padding: 15px 22px; background: #0C1116; border: 1px solid #292E35; border-radius: 11px; cursor: pointer; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #E9EDF2; transition: border-color .2s;">
            <span style="color: #5D666F;">$</span><span>npx caraka init</span>
            <span data-copy-label="COPY" style="font-size: 11px; color: #5D666F; min-width: 48px; text-align: right;">COPY</span>
          </button>
          <a href="/docs" class="hv-btn" style="padding: 15px 26px; background: #E2452C; border-radius: 11px; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #FFEDE7; transition: background .2s;">Read the docs →</a>
        </div>
      </div>
    </section>

    </main>

    <footer style="padding: clamp(44px, 7vh, 70px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1120px, 100%); margin: 0 auto; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #414950;">ꦕ caraka · MIT · v1.0, unproven</span>
        <div style="display: flex; flex-wrap: wrap; gap: clamp(14px, 2.6vw, 28px); font-family: 'JetBrains Mono', monospace; font-size: 12.5px;">
          <a href="/" class="hv-ink" style="color: #7A848F;">Home</a>
          <a href="/docs" class="hv-ink" style="color: #7A848F;">Docs</a>
          <a href="/story" class="hv-ink" style="color: #7A848F;">Story</a>
          <a href="/security" class="hv-ink" style="color: #7A848F;">Security</a>
          <a href="/status" class="hv-ink" style="color: #7A848F;">Status</a>
          <a href="https://github.com/CarakaDev/caraka" class="hv-ink" style="color: #7A848F;">GitHub</a>
        </div>
      </div>
    </footer>

  </div>
</Base>
