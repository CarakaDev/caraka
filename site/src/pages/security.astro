---
// Ported from design/mockups/Caraka Security.dc.html. Markup and inline styles are transcribed
// as-is; see site/AGENTS.md for the substitutions that replace the design-comp runtime.
import Base from '../layouts/Base.astro'
import '../styles/pages/security.css'
import {
  toc,
  headline,
  untrusted,
  trusted,
  threats,
  modes,
  risky,
  mandatory,
  notClaimed,
  commitments,
  inScope,
  outScope,
} from '../data/security'
import MobileMenu from '../components/MobileMenu.astro'
import MobileToc from '../components/MobileToc.astro'
---

<Base page="security">
  <div style="width: 100%; background: #05080C; font-family: 'Public Sans', sans-serif; color: #E9EDF2; position: relative; overflow-x: hidden;">

    <div aria-hidden="true" style="position: fixed; left: 0; top: 0; right: 0; height: 2px; z-index: 110; background: #171C22;">
      <div style="height: 100%; width: 100%; background: linear-gradient(90deg, #E2452C, #FF7A5E); transform-origin: left; transform: scaleX(var(--ck-sp, 0));"></div>
    </div>

    <header style="position: fixed; left: 0; right: 0; top: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 14px clamp(16px, 4vw, 34px); background: rgba(5,8,12,.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid #0C1116;">
      <a href="/" style="display: flex; align-items: center; gap: 12px;">
        <span style="width: 27px; height: 27px; border-radius: 7px; background: #E2452C; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-family: 'Noto Sans Javanese', serif; font-size: 16px; line-height: 1; display: block; transform: translateY(17.5%); color: #FFEDE7;">ꦕ</span></span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .2em; color: #E9EDF2;">caraka</span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .16em; color: #E2452C; padding: 3px 8px; border: 1px solid #2B1612; border-radius: 5px;">SECURITY</span>
      </a>
      <nav data-navlinks="1" style="display: flex; align-items: center; gap: clamp(14px, 2.4vw, 26px); font-family: 'JetBrains Mono', monospace; font-size: 12px;">
        <a href="/" class="hv-ink" style="color: #7A848F;">Home</a>
        <a href="/docs" class="hv-ink" style="color: #7A848F;">Docs</a>
        <a href="/install" class="hv-ink" style="color: #7A848F;">Install</a>
      </nav>
      <a href="mailto:security@caraka.dev" class="hv-ring-ink" style="padding: 9px 16px; border: 1px solid #292E35; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #B2BCC6; transition: border-color .2s, color .2s; white-space: nowrap;">Report ↗</a>
      <MobileMenu links={[{ label: 'Home', href: '/' }, { label: 'Docs', href: '/docs' }, { label: 'Install', href: '/install' }]} cta={{ label: 'Report ↗', href: 'mailto:security@caraka.dev' }} />
    </header>

    <section id="main" style="position: relative; padding: clamp(118px, 17vh, 172px) clamp(20px, 5vw, 60px) clamp(50px, 7vh, 80px); overflow: hidden;">
      <div aria-hidden="true" style="position: absolute; left: 50%; top: 30%; width: min(760px, 120vw); height: min(760px, 120vw); margin-left: min(-380px, -60vw); margin-top: min(-380px, -60vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.11), transparent 62%); animation: ck-bloom 8s ease-in-out infinite; pointer-events: none;"></div>
      <div style="position: relative; width: min(1120px, 100%); margin: 0 auto;">
        <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; animation: ck-boot .8s cubic-bezier(.2,.9,.3,1) both;">
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">THREAT MODEL</span>
          <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX 1s cubic-bezier(.3,.7,.3,1) .25s both;"></span>
        </div>
        <h1 style="margin: 0 0 20px; max-width: 880px; font-size: clamp(30px, 5.4vw, 56px); font-weight: 700; letter-spacing: -.03em; line-height: 1.08; color: #F6F9FC; text-wrap: balance; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .15s both;">Read this before you run <span style="color: #FF7A5E; font-family: 'JetBrains Mono', monospace; font-size: .78em;">npx caraka init</span></h1>
        <p style="margin: 0 0 30px; max-width: 660px; font-size: clamp(15px, 1.9vw, 18px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .28s both;">Caraka connects untrusted input, the contents of a chat, to code execution on your machine. That combination deserves a page rather than a paragraph.</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .4s both;">
          {headline.map((h) => (
            <div style="padding: 20px 22px; background: #0C1116; border: 1px solid #171C22; border-radius: 13px; display: flex; flex-direction: column; gap: 7px;">
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .16em; color: #8EEE98;">{h.tag}</span>
              <span style="font-size: 14.5px; line-height: 1.55; color: #B2BCC6; text-wrap: pretty;">{h.t}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div style="display: flex; gap: clamp(28px, 4vw, 56px); width: min(1240px, 100%); margin: 0 auto; padding: clamp(30px, 5vh, 60px) clamp(20px, 4vw, 44px) clamp(70px, 12vh, 120px);">
      <main style="flex: 1; min-width: 0;">
        <MobileToc chapters={toc} breakpoint={1080} />


        <section id="boundary" style="margin-bottom: clamp(48px, 8vh, 80px); scroll-margin-top: 90px;">
          <div style="display: flex; align-items: baseline; gap: 13px; margin-bottom: 10px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 80%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #E2452C;">01</span>
            <h2 style="margin: 0; font-size: clamp(20px, 2.8vw, 28px); font-weight: 700; letter-spacing: -.02em; color: #F6F9FC;">The trust boundary</h2>
          </div>
          <p style="margin: 0 0 24px; max-width: 660px; font-size: 15px; line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 24%;">One rule holds the whole design together: nothing on the untrusted side can ever change a policy, approve an action, or raise a privilege.</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
            <div style="padding: 26px 28px; background: #0C1116; border: 1px solid #2B1612; border-radius: 14px; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">
              <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .18em; color: #FF93B2; margin-bottom: 16px;">UNTRUSTED</div>
              <div style="display: flex; flex-direction: column; gap: 11px;">
                {untrusted.map((u) => (
                  <span style="display: flex; gap: 11px; font-size: 14px; line-height: 1.5; color: #95A0AB;"><span style="color: #FF93B2; flex-shrink: 0;">×</span>{u}</span>
                ))}
              </div>
            </div>
            <div style="padding: 26px 28px; background: #0C1116; border: 1px solid #171C22; border-radius: 14px; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 3% cover 29%;">
              <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .18em; color: #8EEE98; margin-bottom: 16px;">TRUSTED</div>
              <div style="display: flex; flex-direction: column; gap: 11px;">
                {trusted.map((t) => (
                  <span style="display: flex; gap: 11px; font-size: 14px; line-height: 1.5; color: #95A0AB;"><span style="color: #8EEE98; flex-shrink: 0;">✓</span>{t}</span>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section id="threats" style="margin-bottom: clamp(48px, 8vh, 80px); scroll-margin-top: 90px;">
          <div style="display: flex; align-items: baseline; gap: 13px; margin-bottom: 10px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 80%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #E2452C;">02</span>
            <h2 style="margin: 0; font-size: clamp(20px, 2.8vw, 28px); font-weight: 700; letter-spacing: -.02em; color: #F6F9FC;">Threats and controls</h2>
          </div>
          <p style="margin: 0 0 24px; max-width: 660px; font-size: 15px; line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 24%;">Thirteen threats, each with a primary control and a fallback. Nothing here relies on the agent behaving well.</p>
          <div style="border: 1px solid #171C22; border-radius: 14px; overflow: hidden;">
            {threats.map((t) => (
              <div class="hv-row" style={`display: flex; flex-wrap: wrap; gap: 8px 20px; padding: 16px 20px; border-bottom: 1px solid #171C22; background: #0C1116; transition: background .2s; animation: ck-riseSm linear both; animation-timeline: view(); animation-range: ${t.range};`}>
                <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #FF93B2; width: 34px; flex-shrink: 0; padding-top: 2px;">{t.id}</span>
                <span style="flex: 1; min-width: 190px; font-size: 14px; line-height: 1.5; color: #D2D8DF;">{t.name}</span>
                <span style="flex: 1.5; min-width: 250px; font-size: 13.5px; line-height: 1.55; color: #7A848F; text-wrap: pretty;">{t.control}</span>
              </div>
            ))}
          </div>
        </section>

        <section id="modes" style="margin-bottom: clamp(48px, 8vh, 80px); scroll-margin-top: 90px;">
          <div style="display: flex; align-items: baseline; gap: 13px; margin-bottom: 10px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 80%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #E2452C;">03</span>
            <h2 style="margin: 0; font-size: clamp(20px, 2.8vw, 28px); font-weight: 700; letter-spacing: -.02em; color: #F6F9FC;">Telegram routes</h2>
          </div>
          {/* The comp (line 320) reads "v0.1 has no Caraka policy modes. Identity and
              chat type decide…". `policy_grant` now carries an assisted and a trusted
              mode (src/store/db.ts:93), and chat type stopped being the test when the
              two allowlists arrived (src/core/gateway.ts:161-165). */}
          <p style="margin: 0 0 24px; max-width: 660px; font-size: 15px; line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 24%;">The chat allowlist and the sender allowlist decide whether input reaches Claude; Claude decides when a tool needs permission. Caraka has one policy mode of its own, the trust window, and it is opened for a stated duration rather than set as a default.</p>
          <div style="border: 1px solid #171C22; border-radius: 14px; overflow: hidden;">
            <div style="display: flex; padding: 13px 20px; background: #12100F; border-bottom: 1px solid #2B1612; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .14em; color: #7A848F;">
              <span style="flex: 1.3; min-width: 92px;">ROUTE</span>
              <span style="flex: .7; min-width: 46px;">GET</span>
              <span style="flex: .9; min-width: 62px;">PROMPT</span>
              <span style="flex: .9; min-width: 62px;">APPROVE</span>
              <span style="flex: 1; min-width: 70px;">REPLY</span>
            </div>
            {modes.map((m) => (
              <div style={`display: flex; padding: 15px 20px; border-bottom: 1px solid #171C22; background: ${m.bg}; font-size: 13px; align-items: center; animation: ck-riseSm linear both; animation-timeline: view(); animation-range: ${m.range};`}>
                <span style={`flex: 1.3; min-width: 92px; font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: ${m.tone};`}>{m.name}</span>
                <span style={`flex: .7; min-width: 46px; color: ${m.rTone};`}>{m.r}</span>
                <span style={`flex: .9; min-width: 62px; color: ${m.wTone};`}>{m.w}</span>
                <span style={`flex: .9; min-width: 62px; color: ${m.eTone};`}>{m.e}</span>
                <span style={`flex: 1; min-width: 70px; color: ${m.pTone};`}>{m.p}</span>
              </div>
            ))}
          </div>
          <div style="margin-top: 16px; padding: 18px 20px; background: #12100F; border-left: 2px solid #E2452C; border-radius: 0 11px 11px 0; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">
            <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .16em; color: #FF7A5E; margin-bottom: 11px;">WHEN CLAUDE REQUESTS PERMISSION</div>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              {risky.map((r) => (
                <span style="padding: 6px 12px; background: #05070A; border: 1px solid #2B1612; border-radius: 7px; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: #E0B4A8;">{r}</span>
              ))}
            </div>
          </div>
        </section>

        <section id="defaults" style="margin-bottom: clamp(48px, 8vh, 80px); scroll-margin-top: 90px;">
          <div style="display: flex; align-items: baseline; gap: 13px; margin-bottom: 10px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 80%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #E2452C;">04</span>
            <h2 style="margin: 0; font-size: clamp(20px, 2.8vw, 28px); font-weight: 700; letter-spacing: -.02em; color: #F6F9FC;">What ships turned on</h2>
          </div>
          <p style="margin: 0 0 24px; max-width: 660px; font-size: 15px; line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 24%;">These controls are fixed in v0.2. There is no configuration switch that disables them.</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(268px, 1fr)); gap: 14px;">
            {mandatory.map((m) => (
              <div class="hv-ring-soft" style={`padding: 22px 24px; background: #0C1116; border: 1px solid #171C22; border-radius: 13px; display: flex; gap: 13px; align-items: flex-start; transition: border-color .25s; animation: ck-riseSm linear both; animation-timeline: view(); animation-range: ${m.range};`}>
                <span style="color: #8EEE98; font-family: 'JetBrains Mono', monospace; font-size: 12px; flex-shrink: 0; padding-top: 2px;">⛊</span>
                <span style="font-size: 14px; line-height: 1.6; color: #95A0AB; text-wrap: pretty;">{m.t}</span>
              </div>
            ))}
          </div>
        </section>

        <section id="honest" style="margin-bottom: clamp(48px, 8vh, 80px); scroll-margin-top: 90px;">
          <div style="display: flex; align-items: baseline; gap: 13px; margin-bottom: 10px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 80%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #E2452C;">05</span>
            <h2 style="margin: 0; font-size: clamp(20px, 2.8vw, 28px); font-weight: 700; letter-spacing: -.02em; color: #F6F9FC;">What we do not claim</h2>
          </div>
          <div style="padding: clamp(24px, 3.4vw, 34px); background: #12100F; border: 1px solid #2B1612; border-radius: 15px; display: flex; flex-direction: column; gap: 15px; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 28%;">
            {notClaimed.map((n) => (
              <div style="display: flex; gap: 13px;">
                <span style="color: #FF93B2; font-family: 'JetBrains Mono', monospace; font-size: 12px; flex-shrink: 0; padding-top: 3px;">·</span>
                <span style="font-size: 14.5px; line-height: 1.68; color: #B2BCC6; text-wrap: pretty;">{n}</span>
              </div>
            ))}
          </div>
        </section>

        <section id="report" style="scroll-margin-top: 90px;">
          <div style="display: flex; align-items: baseline; gap: 13px; margin-bottom: 10px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 80%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #E2452C;">06</span>
            <h2 style="margin: 0; font-size: clamp(20px, 2.8vw, 28px); font-weight: 700; letter-spacing: -.02em; color: #F6F9FC;">Reporting a vulnerability</h2>
          </div>
          <p style="margin: 0 0 22px; max-width: 660px; font-size: 15px; line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 24%;">Email <a href="mailto:security@caraka.dev">security@caraka.dev</a>, or use GitHub private vulnerability reporting. Never open a public issue for a security problem.</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-bottom: 22px;">
            {commitments.map((c) => (
              <div style={`padding: 24px 26px; background: #0C1116; border: 1px solid #171C22; border-radius: 13px; display: flex; flex-direction: column; gap: 8px; animation: ck-riseSm linear both; animation-timeline: view(); animation-range: ${c.range};`}>
                <span style="font-family: 'JetBrains Mono', monospace; font-size: clamp(22px, 3.4vw, 30px); font-weight: 700; color: #FF7A5E; letter-spacing: -.02em;">{c.n}</span>
                <span style="font-size: 14px; line-height: 1.55; color: #95A0AB; text-wrap: pretty;">{c.t}</span>
              </div>
            ))}
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(268px, 1fr)); gap: 14px;">
            <div style="padding: 24px 26px; background: #0C1116; border: 1px solid #171C22; border-radius: 13px;">
              <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .18em; color: #8EEE98; margin-bottom: 14px;">IN SCOPE</div>
              <div style="display: flex; flex-direction: column; gap: 10px;">
                {inScope.map((s) => (
                  <span style="font-size: 13.5px; line-height: 1.5; color: #95A0AB; text-wrap: pretty;">{s}</span>
                ))}
              </div>
            </div>
            <div style="padding: 24px 26px; background: #0C1116; border: 1px solid #171C22; border-radius: 13px;">
              <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .18em; color: #7A848F; margin-bottom: 14px;">OUT OF SCOPE</div>
              <div style="display: flex; flex-direction: column; gap: 10px;">
                {outScope.map((s) => (
                  <span style="font-size: 13.5px; line-height: 1.5; color: #5D666F; text-wrap: pretty;">{s}</span>
                ))}
              </div>
            </div>
          </div>
        </section>
      </main>

      <aside data-toc="1" style="width: 186px; flex-shrink: 0;">
        <div style="position: sticky; top: 104px; display: flex; flex-direction: column; gap: 2px;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .2em; color: #414950; margin-bottom: 12px;">ON THIS PAGE</div>
          {toc.map((t) => (
            <a href={t.href} class="hv-ring-ink" style="display: flex; align-items: baseline; gap: 9px; padding: 7px 0 7px 12px; border-left: 1px solid #171C22; font-size: 12.5px; color: #7A848F; transition: color .2s, border-color .2s;">
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #414950;">{t.no}</span><span>{t.title}</span>
            </a>
          ))}
        </div>
      </aside>
    </div>

    <footer style="padding: clamp(44px, 7vh, 70px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1240px, 100%); margin: 0 auto; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #414950;">ꦕ caraka · security@caraka.dev</span>
        <div style="display: flex; flex-wrap: wrap; gap: clamp(14px, 2.6vw, 28px); font-family: 'JetBrains Mono', monospace; font-size: 12.5px;">
          <a href="/" class="hv-ink" style="color: #7A848F;">Home</a>
          <a href="/docs" class="hv-ink" style="color: #7A848F;">Docs</a>
          <a href="/install" class="hv-ink" style="color: #7A848F;">Install</a>
          <a href="https://github.com/CarakaDev/caraka/blob/main/SECURITY.md" class="hv-ink" style="color: #7A848F;">SECURITY.md</a>
        </div>
      </div>
    </footer>
  </div>
</Base>
