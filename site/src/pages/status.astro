---
// Ported from design/mockups/Caraka Status.dc.html. Markup and inline styles are
// transcribed as-is; see site/AGENTS.md for the substitutions that replace the
// design-comp runtime.
import Base from '../layouts/Base.astro'
import '../styles/pages/status.css'
import { stats, phases, releases, candidates, never } from '../data/status'
import MobileMenu from '../components/MobileMenu.astro'
---

<Base page="status">
  <div style="width: 100%; background: #05080C; font-family: 'Public Sans', sans-serif; color: #E9EDF2; position: relative; overflow-x: hidden;">

    <div aria-hidden="true" style="position: fixed; left: 0; top: 0; right: 0; height: 2px; z-index: 110; background: #171C22;">
      <div style="height: 100%; width: 100%; background: linear-gradient(90deg, #E2452C, #FF7A5E); transform-origin: left; transform: scaleX(var(--ck-sp, 0));"></div>
    </div>

    <header style="position: fixed; left: 0; right: 0; top: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 14px clamp(16px, 4vw, 34px); background: rgba(5,8,12,.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid #0C1116;">
      <a href="/" style="display: flex; align-items: center; gap: 12px;">
        <span style="width: 27px; height: 27px; border-radius: 7px; background: #E2452C; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-family: 'Noto Sans Javanese', serif; font-size: 16px; line-height: 1; display: block; transform: translateY(17.5%); color: #FFEDE7;">ꦕ</span></span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .2em; color: #E9EDF2;">caraka</span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .16em; color: #E2452C; padding: 3px 8px; border: 1px solid #2B1612; border-radius: 5px;">STATUS</span>
      </a>
      <nav data-navlinks="1" style="display: flex; align-items: center; gap: clamp(14px, 2.4vw, 26px); font-family: 'JetBrains Mono', monospace; font-size: 12px;">
        <a href="/" class="hv-ink" style="color: #7A848F;">Home</a>
        <a href="/docs" class="hv-ink" style="color: #7A848F;">Docs</a>
        <a href="/install" class="hv-ink" style="color: #7A848F;">Install</a>
      </nav>
      <a href="https://github.com/CarakaDev/caraka" class="hv-ring-ink" style="padding: 9px 16px; border: 1px solid #292E35; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #B2BCC6; transition: border-color .2s, color .2s; white-space: nowrap;">GitHub ↗</a>
      <MobileMenu links={[{ label: 'Home', href: '/' }, { label: 'Docs', href: '/docs' }, { label: 'Install', href: '/install' }]} cta={{ label: 'GitHub ↗', href: 'https://github.com/CarakaDev/caraka' }} />
    </header>

    <main id="main">

    <section style="position: relative; padding: clamp(118px, 17vh, 172px) clamp(20px, 5vw, 60px) clamp(50px, 7vh, 80px); overflow: hidden;">
      <div aria-hidden="true" style="position: absolute; left: 50%; top: 30%; width: min(720px, 118vw); height: min(720px, 118vw); margin-left: min(-360px, -59vw); margin-top: min(-360px, -59vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.11), transparent 62%); animation: ck-bloom 8s ease-in-out infinite; pointer-events: none;"></div>
      <div style="position: relative; width: min(1120px, 100%); margin: 0 auto;">
        <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; animation: ck-boot .8s cubic-bezier(.2,.9,.3,1) both;">
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">STATUS &amp; ROADMAP</span>
          <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX 1s cubic-bezier(.3,.7,.3,1) .25s both;"></span>
        </div>
        <h1 style="margin: 0 0 18px; max-width: 880px; font-size: clamp(30px, 5.4vw, 56px); font-weight: 700; letter-spacing: -.03em; line-height: 1.08; color: #F6F9FC; text-wrap: balance; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .15s both;">v0.1 is usable. The dogfood gate is still open.</h1>
        <p style="margin: 0 0 30px; max-width: 660px; font-size: clamp(15px, 1.9vw, 18px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .28s both;">The package now bridges private Telegram chat to Claude Code. It remains a preview until live Telegram checks and a week of daily use close the phase; roadmap features are not presented as shipped.</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .4s both;">
          {stats.map((s) => (
            <div style={`padding: 22px 24px; background: ${s.bg}; border: 1px solid ${s.border}; border-radius: 13px; display: flex; flex-direction: column; gap: 7px;`}>
              <span style={`font-family: 'JetBrains Mono', monospace; font-size: clamp(21px, 3.2vw, 28px); font-weight: 700; letter-spacing: -.02em; color: ${s.tone};`}>{s.n}</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .16em; color: #5D666F;">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(50px, 8vh, 80px) clamp(20px, 5vw, 60px) clamp(70px, 11vh, 120px); border-top: 1px solid #0C1116;">
      <div style="width: min(1000px, 100%); margin: 0 auto;">
        <div style="max-width: 700px; margin-bottom: clamp(30px, 4vh, 46px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 75%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">01 — PHASES</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0 0 16px; font-size: clamp(25px, 4.2vw, 40px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Every phase answers one question that can cancel the next.</h2>
          <p style="margin: 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">This is a sequence of proofs rather than a feature list. Stopping is allowed. Turning is allowed. Adding scope without removing scope is not.</p>
        </div>

        <div style="position: relative; display: flex; flex-direction: column;">
          <div aria-hidden="true" style="position: absolute; left: 21px; top: 30px; bottom: 60px; width: 1px; background: linear-gradient(180deg, #E2452C, #2B1612); transform-origin: top; animation: ck-drawY linear both; animation-timeline: view(); animation-range: entry 4% cover 62%;"></div>
          {phases.map((p) => (
            <div style={`position: relative; display: flex; gap: clamp(16px, 2.4vw, 24px); padding-bottom: clamp(20px, 3vh, 30px); animation: ck-slideR linear both; animation-timeline: view(); animation-range: ${p.range};`}>
              <span style={`position: relative; width: 43px; height: 43px; flex-shrink: 0; border-radius: 50%; border: 1px solid ${p.ring}; background: #05080C; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: ${p.ring};`}>
                {p.n}
                {p.live && (
                  <span aria-hidden="true" style="position: absolute; inset: -1px; border-radius: 50%; border: 1px solid #E2452C; animation: ck-pulse 2.6s ease-out infinite;"></span>
                )}
              </span>
              <div style={`flex: 1; min-width: 0; padding: 18px 22px; background: ${p.bg}; border: 1px solid ${p.border}; border-radius: 13px;`}>
                <div style="display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center; margin-bottom: 9px;">
                  <span style="font-size: 16.5px; font-weight: 600; color: #F6F9FC;">{p.title}</span>
                  <span style={`padding: 4px 11px; border-radius: 100px; background: ${p.chipBg}; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: ${p.chipInk}; white-space: nowrap;`}>{p.state}</span>
                  <span style="margin-left: auto; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #5D666F;">{p.dur}</span>
                </div>
                <p style="margin: 0 0 12px; font-size: 14.5px; line-height: 1.65; color: #95A0AB; text-wrap: pretty;">{p.q}</p>
                <div style={`display: flex; gap: 11px; padding-top: 12px; border-top: 1px solid ${p.border};`}>
                  <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .14em; color: #5D666F; flex-shrink: 0; padding-top: 2px;">DONE WHEN</span>
                  <span style="font-size: 13.5px; line-height: 1.6; color: #7A848F; text-wrap: pretty;">{p.gate}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(70px, 11vh, 120px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; background: #070A0E;">
      <div style="width: min(1000px, 100%); margin: 0 auto;">
        <div style="max-width: 700px; margin-bottom: clamp(28px, 4vh, 42px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 75%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">02 — RELEASES</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0; font-size: clamp(25px, 4.2vw, 40px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Changelog</h2>
        </div>
        {releases.map((r) => (
          <div style={`margin-bottom: 16px; border: 1px solid ${r.border}; border-radius: 15px; overflow: hidden; animation: ck-rise linear both; animation-timeline: view(); animation-range: ${r.range};`}>
            <div style={`display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; padding: 16px 22px; background: ${r.headBg}; border-bottom: 1px solid ${r.border};`}>
              <span style={`font-family: 'JetBrains Mono', monospace; font-size: 15px; font-weight: 700; color: ${r.tone};`}>{r.v}</span>
              <span style={`padding: 4px 11px; border-radius: 100px; background: ${r.chipBg}; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: ${r.chipInk};`}>{r.state}</span>
              <span style="margin-left: auto; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: #5D666F;">{r.date}</span>
            </div>
            <div style="padding: 20px 22px; background: #0C1116; display: flex; flex-direction: column; gap: 16px;">
              {r.groups.map((g) => (
                <div>
                  <div style={`font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .16em; color: ${g.tone}; margin-bottom: 10px;`}>{g.label}</div>
                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    {g.items.map((i) => (
                      <span style="display: flex; gap: 11px; font-size: 14px; line-height: 1.6; color: #95A0AB; text-wrap: pretty;"><span style="color: #414950; flex-shrink: 0;">·</span>{i}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section style="position: relative; padding: clamp(70px, 11vh, 120px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1000px, 100%); margin: 0 auto;">
        <div style="max-width: 700px; margin-bottom: clamp(28px, 4vh, 42px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 75%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">03 — AFTER v1.0</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0 0 16px; font-size: clamp(25px, 4.2vw, 40px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Candidates, not promises.</h2>
          <p style="margin: 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">Each one has an entry condition. Nothing gets built because it sounded good in a meeting.</p>
        </div>
        <div style="border: 1px solid #171C22; border-radius: 14px; overflow: hidden; margin-bottom: 26px;">
          {candidates.map((c) => (
            <div class="hv-row" style={`display: flex; flex-wrap: wrap; gap: 8px 20px; padding: 15px 20px; border-bottom: 1px solid #171C22; background: #0C1116; transition: background .2s; animation: ck-riseSm linear both; animation-timeline: view(); animation-range: ${c.range};`}>
              <span style="flex: 1; min-width: 210px; font-size: 14px; line-height: 1.5; color: #D2D8DF;">{c.what}</span>
              <span style="flex: 1.2; min-width: 230px; font-size: 13.5px; line-height: 1.55; color: #7A848F; text-wrap: pretty;">{c.when}</span>
            </div>
          ))}
        </div>
        <div style="padding: clamp(24px, 3.4vw, 34px); background: #12100F; border: 1px solid #2B1612; border-radius: 15px; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 28%;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .2em; color: #FF7A5E; margin-bottom: 16px;">NEVER, WHATEVER THE DEMAND</div>
          <div style="display: flex; flex-wrap: wrap; gap: 9px;">
            {never.map((n) => (
              <span style="padding: 8px 15px; background: #05070A; border: 1px solid #2B1612; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #E0B4A8; text-decoration: line-through;">{n}</span>
            ))}
          </div>
          <p style="margin: 16px 0 0; font-size: 14px; line-height: 1.65; color: #95A0AB; text-wrap: pretty;">Each of these would turn Caraka into the thing it was built to avoid. The written non-goals are the defence, and they are the reason a two-line feature request can be declined without argument.</p>
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(70px, 11vh, 130px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; overflow: hidden;">
      <div aria-hidden="true" style="position: absolute; left: 50%; top: 50%; width: min(680px, 118vw); height: min(680px, 118vw); margin-left: min(-340px, -59vw); margin-top: min(-340px, -59vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.12), transparent 62%); pointer-events: none;"></div>
      <div style="position: relative; width: min(640px, 100%); margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px;">
        <h2 style="margin: 0; font-size: clamp(23px, 4vw, 36px); font-weight: 700; letter-spacing: -.03em; line-height: 1.16; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 28%;">Watch it get built, or help build it.</h2>
        <p style="margin: 0; font-size: clamp(14.5px, 1.8vw, 16.5px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">Adding a coding agent on the CLI route is a single YAML file with no core code. That is the lowest-friction way in.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 8% cover 34%;">
          <a href="https://github.com/CarakaDev/caraka" class="hv-btn" style="padding: 15px 26px; background: #E2452C; border-radius: 11px; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #FFEDE7; transition: background .2s;">Watch on GitHub →</a>
          <a href="https://github.com/CarakaDev/caraka/blob/main/CONTRIBUTING.md" class="hv-ring-ink" style="padding: 15px 26px; border: 1px solid #292E35; border-radius: 11px; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #B2BCC6; transition: border-color .2s, color .2s;">Contributing</a>
        </div>
      </div>
    </section>

    </main>

    <footer style="padding: clamp(44px, 7vh, 70px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1000px, 100%); margin: 0 auto; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #414950;">ꦕ caraka · MIT · v0.1 preview</span>
        <div style="display: flex; flex-wrap: wrap; gap: clamp(14px, 2.6vw, 28px); font-family: 'JetBrains Mono', monospace; font-size: 12.5px;">
          <a href="/" class="hv-ink" style="color: #7A848F;">Home</a>
          <a href="/docs" class="hv-ink" style="color: #7A848F;">Docs</a>
          <a href="/install" class="hv-ink" style="color: #7A848F;">Install</a>
          <a href="https://github.com/CarakaDev/caraka/blob/main/CHANGELOG.md" class="hv-ink" style="color: #7A848F;">CHANGELOG.md</a>
        </div>
      </div>
    </footer>

  </div>
</Base>
