            <div style="position: absolute; inset: 0; border: 1px dashed rgba(111,185,240,0.30);"></div>
            <div style="position: absolute; left: 46px; top: 0; bottom: 0; width: 1px; background: rgba(111,185,240,0.14);"></div>
            <div style="position: absolute; right: 46px; top: 0; bottom: 0; width: 1px; background: rgba(111,185,240,0.14);"></div>
            <div style="position: absolute; left: 0; right: 0; top: 46px; height: 1px; background: rgba(111,185,240,0.14);"></div>
            <div style="position: absolute; left: 0; right: 0; bottom: 46px; height: 1px; background: rgba(111,185,240,0.14);"></div>
            <div style="position: absolute; left: 14px; top: 14px; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #4E7EA6;">½d</div>
            <div style="position: relative; width: 186px; height: 93px; display: flex; align-items: center; justify-content: center;">
              <div style={`position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 -92px; border-radius: 50%; border: 1.5px solid ${accent};`}></div>
              <div style={`position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 0; border-radius: 50%; border: 1.5px solid ${accent};`}></div>
              <span style="position: relative; font-family: 'Noto Sans Javanese', serif; font-size: 52px; line-height: 1; display: block; transform: translateY(17.5%); color: #F2F8FF;">ꦕ</span>
            </div>
