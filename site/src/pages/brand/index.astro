---
// Ported from design/mockups/Caraka Brandkit.dc.html. Markup and inline styles are
// transcribed as-is; see site/AGENTS.md for the substitutions that replace the
// design-comp runtime.
import Base from '../../layouts/Base.astro'
import '../../styles/pages/brand.css'
import '../../styles/mobile/brand.css'
import { accent, accentInk, glowSoft, glowStrong, inkOnAccent, ramp, neutrals, semantic, donts } from '../../data/brand'
---

<Base page="brand">
  <div class="ck-m-shell" style="width: 1200px; margin: 0 auto; background: #05070A; font-family: 'Public Sans', sans-serif; color: #E8F2FB;">

    <main id="main">

    <section style="padding: 90px 80px 80px; border-bottom: 1px solid rgba(111,185,240,0.10);">
      <div class="ck-m-stack" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 64px;">
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.24em; color: #4E7EA6;">CARAKA · LOGO BOOK</div>
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; color: #3F5B72;">v1.0 · 7 AGUSTUS 2026</div>
      </div>

      <div style="position: relative; height: 460px; background: #080B10; border: 1px solid rgba(111,185,240,0.10); border-radius: 16px; overflow: hidden; display: flex; align-items: center; justify-content: center; background-image: linear-gradient(rgba(111,185,240,0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(111,185,240,0.055) 1px, transparent 1px); background-size: 32px 32px; animation: ck-drift 14s linear infinite;">
        <div aria-hidden="true" style={`position: absolute; left: 22px; top: 22px; width: 22px; height: 22px; border-top: 2px solid ${accent}; border-left: 2px solid ${accent};`}></div>
        <div aria-hidden="true" style={`position: absolute; right: 22px; top: 22px; width: 22px; height: 22px; border-top: 2px solid ${accent}; border-right: 2px solid ${accent};`}></div>
        <div aria-hidden="true" style={`position: absolute; left: 22px; bottom: 22px; width: 22px; height: 22px; border-bottom: 2px solid ${accent}; border-left: 2px solid ${accent};`}></div>
        <div aria-hidden="true" style={`position: absolute; right: 22px; bottom: 22px; width: 22px; height: 22px; border-bottom: 2px solid ${accent}; border-right: 2px solid ${accent};`}></div>

        <div class="ck-m-fix" style="position: relative; width: 320px; height: 320px; display: flex; align-items: center; justify-content: center;">
          <div style={`position: absolute; inset: 0; border-radius: 50%; background: repeating-conic-gradient(from 0deg, ${glowSoft} 0deg 0.6deg, transparent 0.6deg 12deg); animation: ck-spin 40s linear infinite;`}></div>
          <div style="position: absolute; inset: 9px; border-radius: 50%; background: #080B10;"></div>
          <div style={`position: absolute; inset: 22px; border-radius: 50%; border: 1px solid transparent; border-top-color: ${accent}; border-right-color: ${glowSoft}; animation: ck-spin 6.5s linear infinite;`}></div>
          <div style={`position: absolute; inset: 44px; border-radius: 50%; border: 1px solid transparent; border-bottom-color: ${glowSoft}; animation: ck-spin-rev 10s linear infinite;`}></div>
          <div style="position: absolute; inset: 64px; border-radius: 50%; border: 1px dashed rgba(111,185,240,0.14); animation: ck-spin 26s linear infinite;"></div>
          <div style={`position: absolute; left: 50%; top: 50%; width: 200px; height: 200px; margin: -100px 0 0 -100px; border-radius: 50%; background: ${glowSoft}; filter: blur(50px); animation: ck-bloom 6s ease-in-out infinite;`}></div>

          <div style="position: relative; width: 212px; height: 106px; display: flex; align-items: center; justify-content: center;">
            <div style="position: absolute; left: 50%; top: 50%; width: 102px; height: 102px; margin: -51px 0 0 -102px; border-radius: 50%; border: 1px solid rgba(111,185,240,0.14);"></div>
            <div style="position: absolute; left: 50%; top: 50%; width: 102px; height: 102px; margin: -51px 0 0 0; border-radius: 50%; border: 1px solid rgba(111,185,240,0.14);"></div>
            <div style={`position: absolute; left: 50%; top: 50%; width: 102px; height: 102px; margin: -51px 0 0 -102px; border-radius: 50%; border: 1px solid transparent; border-top-color: ${glowStrong}; border-right-color: ${glowSoft}; animation: ck-spin 3.8s linear infinite;`}></div>
            <div style={`position: absolute; left: 50%; top: 50%; width: 102px; height: 102px; margin: -51px 0 0 0; border-radius: 50%; border: 1px solid transparent; border-top-color: ${glowStrong}; border-left-color: ${glowSoft}; animation: ck-spin-rev 3.8s linear infinite;`}></div>
            <div style="position: absolute; left: 50%; top: 50%; width: 102px; height: 102px; margin: -51px 0 0 -102px; animation: ck-spin 3.8s linear infinite;"><div style={`position: absolute; left: 100%; top: 50%; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%; background: #F7FBFF; box-shadow: 0 0 14px 4px ${glowStrong};`}></div></div>
            <div style="position: absolute; left: 50%; top: 50%; width: 102px; height: 102px; margin: -51px 0 0 0; animation: ck-spin-rev 3.8s linear infinite;"><div style={`position: absolute; left: 0; top: 50%; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%; background: #F7FBFF; box-shadow: 0 0 14px 4px ${glowStrong};`}></div></div>
            <span style={`position: relative; font-family: 'Noto Sans Javanese', serif; font-size: 60px; line-height: 1; display: block; transform: translateY(17.5%); color: #F7FBFF; text-shadow: 0 0 34px ${glowStrong};`}>ꦕ</span>
          </div>
        </div>

        <div style="position: absolute; left: 0; right: 0; bottom: 40px; display: flex; flex-direction: column; align-items: center; gap: 9px;">
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 21px; font-weight: 500; letter-spacing: 0.36em; text-indent: 0.36em; color: #F2F8FF;">caraka</span>
          <div style="display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-size: 9.5px; letter-spacing: 0.22em; color: #4E7EA6;">
            <span aria-hidden="true" style="width: 5px; height: 5px; border-radius: 50%; background: #8EEE98; box-shadow: 0 0 8px 2px rgba(142,238,152,0.6);"></span>
            <span>UTUSAN · TERHUBUNG</span>
          </div>
        </div>
      </div>

      <div class="ck-m-cards" style="display: flex; gap: 56px; margin-top: 56px;">
        <div style="flex: 1;">
          <h1 style="margin: 0 0 14px; font-size: 40px; font-weight: 700; letter-spacing: -0.025em; color: #F2F8FF;">Logo Book</h1>
          <p style="margin: 0; font-size: 15.5px; line-height: 1.65; color: #8FAAC2; text-wrap: pretty;">Panduan lengkap identitas visual Caraka: filosofi, anatomi lambang, versi animasi dan statis, favicon, aturan ruang, penempatan, dan batasan pemakaian.</p>
        </div>
        <div class="ck-m-rows" style="width: 300px; display: flex; flex-direction: column; gap: 12px; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: #6E93B2;">
          <div style="display: flex; justify-content: space-between;"><span style="color:#3F5B72;">nama</span><span>Caraka · ꦕꦫꦏ</span></div>
          <div style="display: flex; justify-content: space-between;"><span style="color:#3F5B72;">arti</span><span>utusan</span></div>
          <div style="display: flex; justify-content: space-between;"><span style="color:#3F5B72;">domain</span><span>caraka.dev</span></div>
          <div style="display: flex; justify-content: space-between;"><span style="color:#3F5B72;">lisensi</span><span>MIT</span></div>
        </div>
      </div>
    </section>

    <section style="padding: 80px; border-bottom: 1px solid rgba(111,185,240,0.10);">
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.24em; color: #4E7EA6; margin-bottom: 32px;">01 · FILOSOFI</div>
      <div class="ck-m-cards" style="display: flex; gap: 64px;">
        <div style="width: 420px; flex-shrink: 0;">
          <div class="ck-m-rows" style="background: #080B10; border: 1px solid rgba(111,185,240,0.10); border-radius: 14px; padding: 40px 36px; display: flex; flex-direction: column; gap: 20px;">
            <div style="display: flex; align-items: baseline; gap: 18px;"><span style="font-family: 'Noto Sans Javanese', serif; font-size: 34px; line-height: 1.5; color: #F2F8FF;">ꦲꦤꦕꦫꦏ</span><span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #4E7EA6;">hana caraka</span></div>
            <div style="display: flex; align-items: baseline; gap: 18px;"><span style="font-family: 'Noto Sans Javanese', serif; font-size: 34px; line-height: 1.5; color: #8FAAC2;">ꦢꦠꦱꦮꦭ</span><span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #4E7EA6;">data sawala</span></div>
            <div style="display: flex; align-items: baseline; gap: 18px;"><span style="font-family: 'Noto Sans Javanese', serif; font-size: 34px; line-height: 1.5; color: #8FAAC2;">ꦥꦝꦗꦪꦚ</span><span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #4E7EA6;">padha jayanya</span></div>
            <div style="display: flex; align-items: baseline; gap: 18px;"><span style="font-family: 'Noto Sans Javanese', serif; font-size: 34px; line-height: 1.5; color: #6E93B2;">ꦩꦒꦧꦛꦔ</span><span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #4E7EA6;">maga bathanga</span></div>
          </div>
        </div>
        <div style="flex: 1; display: flex; flex-direction: column; gap: 20px;">
          <h2 style="margin: 0; font-size: 27px; font-weight: 700; letter-spacing: -0.02em; color: #F2F8FF; text-wrap: pretty;">Kesetiaan tanpa konteks itu berbahaya</h2>
          <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #8FAAC2; text-wrap: pretty;"><strong style="color:#C9DFF2;font-weight:600;">Caraka</strong> berarti utusan. Ia juga kata pertama aksara Jawa — dari legenda dua abdi Aji Saka, Dora dan Sembada.</p>
          <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #8FAAC2; text-wrap: pretty;">Sembada diberi pusaka untuk dijaga, dengan pesan: jangan serahkan kepada siapa pun kecuali aku sendiri. Belakangan Dora dikirim mengambilnya, membawa pesan: ambil dan bawa kembali.</p>
          <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #8FAAC2; text-wrap: pretty;">Keduanya patuh dengan sempurna. Keduanya benar menurut instruksi yang mereka pegang. Keduanya sama kuat. Keduanya mati — bukan karena pengkhianatan, melainkan karena dua perintah yang bertabrakan, tanpa cara memverifikasi, tanpa manusia di antaranya pada saat yang menentukan.</p>
          <div style="height: 1px; background: rgba(111,185,240,0.12); margin: 4px 0;"></div>
          <div style="display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; gap: 16px;"><span style={`font-family: 'JetBrains Mono', monospace; font-size: 11px; color: ${accent}; width: 132px; flex-shrink: 0; padding-top: 2px;`}>data sawala</span><span style="font-size: 14px; line-height: 1.6; color: #9FC4E0;">memori berprovenance — setiap keputusan menyebut buktinya</span></div>
            <div style="display: flex; gap: 16px;"><span style={`font-family: 'JetBrains Mono', monospace; font-size: 11px; color: ${accent}; width: 132px; flex-shrink: 0; padding-top: 2px;`}>tak ada yang bertanya</span><span style="font-size: 14px; line-height: 1.6; color: #9FC4E0;">approval lewat ketukan, bukan teks yang bisa dipalsukan</span></div>
            <div style="display: flex; gap: 16px;"><span style={`font-family: 'JetBrains Mono', monospace; font-size: 11px; color: ${accent}; width: 132px; flex-shrink: 0; padding-top: 2px;`}>maga bathanga</span><span style="font-size: 14px; line-height: 1.6; color: #9FC4E0;">audit append-only — kerja tidak berakhir sia-sia tanpa jejak</span></div>
          </div>
        </div>
      </div>
    </section>

    <section style="padding: 80px; border-bottom: 1px solid rgba(111,185,240,0.10);">
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.24em; color: #4E7EA6; margin-bottom: 12px;">02 · ANATOMI LAMBANG</div>
      <p style="margin: 0 0 40px; font-size: 15px; line-height: 1.65; color: #8FAAC2; max-width: 680px; text-wrap: pretty;">Lambang dibangun dari satu unit: diameter lingkaran <strong style="color:#C9DFF2;font-weight:600;">d</strong>. Dua lingkaran identik bersinggungan di titik pusat komposisi, membentuk ∞. Aksara ꦕ diletakkan di persilangan itu.</p>

      <div class="ck-m-cards" style="display: flex; gap: 24px;">
        <div class="ck-m-scroll" style="flex: 1; background: #080B10; border: 1px solid rgba(111,185,240,0.10); border-radius: 14px; padding: 40px; display: flex; align-items: center; justify-content: center;">
          <div style="position: relative; width: 300px; height: 200px;">
            <div style="position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgba(111,185,240,0.22);"></div>
            <div style="position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: rgba(111,185,240,0.22);"></div>
            <div style={`position: absolute; left: 50%; top: 50%; width: 102px; height: 102px; margin: -51px 0 0 -102px; border-radius: 50%; border: 1px solid ${accent};`}></div>
            <div style={`position: absolute; left: 50%; top: 50%; width: 102px; height: 102px; margin: -51px 0 0 0; border-radius: 50%; border: 1px solid ${accent};`}></div>
            <div style="position: absolute; left: 50%; top: 50%; width: 102px; height: 1px; margin: -51px 0 0 -102px; background: rgba(255,255,255,0.30);"></div>
            <div style="position: absolute; left: 50%; top: 50%; margin: -66px 0 0 -66px; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #8FAAC2;">d</div>
            <div style="position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%; background: #F7FBFF;"></div>
            <span aria-hidden="true" style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-family: 'Noto Sans Javanese', serif; font-size: 60px; line-height: 1; color: rgba(247,251,255,0.16);">ꦕ</span>
          </div>
        </div>

        <div class="ck-m-scroll" style="flex: 1; background: #080B10; border: 1px solid rgba(111,185,240,0.10); border-radius: 14px; padding: 40px; display: flex; align-items: center; justify-content: center;">
          <div style="position: relative; width: 300px; height: 200px;">
            <div style="position: absolute; left: 50%; top: 50%; width: 102px; height: 102px; margin: -51px 0 0 -102px; border-radius: 50%; border: 1px solid rgba(111,185,240,0.20);"></div>
            <div style="position: absolute; left: 50%; top: 50%; width: 102px; height: 102px; margin: -51px 0 0 0; border-radius: 50%; border: 1px solid rgba(111,185,240,0.20);"></div>
            <div style="position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgba(200,90,90,0.55);"></div>
            <div style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center;">
              <span style="font-family: 'Noto Sans Javanese', serif; font-size: 60px; line-height: 1; display: block; transform: translateY(17.5%); color: #F7FBFF;">ꦕ</span>
            </div>
            <div style="position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #6E93B2; white-space: nowrap;">koreksi optis · translateY(17.5%) · terukur</div>
          </div>
        </div>
      </div>

      <div class="ck-m-cards" style="display: flex; gap: 24px; margin-top: 24px;">
        <div style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 0.16em; color: #4E7EA6;">KONSTRUKSI</div>
          <p style="margin: 0; font-size: 13.5px; line-height: 1.65; color: #8FAAC2; text-wrap: pretty;">Jarak antar pusat lingkaran = <strong style="color:#C9DFF2;font-weight:600;">d</strong>. Lebar total = 2d. Tinggi = d. Aksara diset pada 0,59d dan berdiri di titik singgung.</p>
        </div>
        <div style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 0.16em; color: #4E7EA6;">PERATAAN</div>
          <p style="margin: 0; font-size: 13.5px; line-height: 1.65; color: #8FAAC2; text-wrap: pretty;">Font aksara Jawa menyediakan ruang sandhangan di atas dan pasangan di bawah. ꦕ tidak memakai keduanya, jadi wajib <code style="font-family:'JetBrains Mono',monospace;font-size:12px;color:#C9DFF2;">line-height:1</code> + <code style="font-family:'JetBrains Mono',monospace;font-size:12px;color:#C9DFF2;">translateY(17.5%)</code>.</p>
          <p style="margin: 0; font-size: 12.5px; line-height: 1.6; color: #6E93B2; text-wrap: pretty;">Angka ini <strong style="color:#9FC4E0;font-weight:600;">terukur, bukan dikira</strong>. Pada 100px: tinta membentang 55px di atas garis dasar dan 0px di bawahnya, sedangkan kotak font membentang 112/92. Pusat tinta jatuh 17,5px di atas pusat kotak — persis nilai koreksinya.</p>
        </div>
      </div>
    </section>

    <section style="padding: 80px; border-bottom: 1px solid rgba(111,185,240,0.10);">
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.24em; color: #4E7EA6; margin-bottom: 12px;">03 · LOGO ANIMASI</div>
      <p style="margin: 0 0 40px; font-size: 15px; line-height: 1.65; color: #8FAAC2; max-width: 680px; text-wrap: pretty;">Versi hidup dipakai di hero situs, splash <code style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9DFF2;">caraka init</code>, dan video. <strong style="color:#C9DFF2;font-weight:600;">Tidak pernah</strong> di favicon, avatar, atau badge.</p>

      <div class="ck-m-cards" style="display: flex; gap: 24px;">
        <div style="width: 480px; flex-shrink: 0; position: relative; height: 400px; background: #080B10; border: 1px solid rgba(111,185,240,0.10); border-radius: 14px; overflow: hidden; display: flex; align-items: center; justify-content: center; background-image: linear-gradient(rgba(111,185,240,0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(111,185,240,0.055) 1px, transparent 1px); background-size: 32px 32px; animation: ck-drift 14s linear infinite;">
          <div aria-hidden="true" style={`position: absolute; left: 18px; top: 18px; width: 20px; height: 20px; border-top: 2px solid ${accent}; border-left: 2px solid ${accent};`}></div>
          <div aria-hidden="true" style={`position: absolute; right: 18px; top: 18px; width: 20px; height: 20px; border-top: 2px solid ${accent}; border-right: 2px solid ${accent};`}></div>
          <div aria-hidden="true" style={`position: absolute; left: 18px; bottom: 18px; width: 20px; height: 20px; border-bottom: 2px solid ${accent}; border-left: 2px solid ${accent};`}></div>
          <div aria-hidden="true" style={`position: absolute; right: 18px; bottom: 18px; width: 20px; height: 20px; border-bottom: 2px solid ${accent}; border-right: 2px solid ${accent};`}></div>
          <div class="ck-m-fix" style="position: relative; width: 280px; height: 280px; display: flex; align-items: center; justify-content: center;">
            <div style={`position: absolute; inset: 0; border-radius: 50%; background: repeating-conic-gradient(from 0deg, ${glowSoft} 0deg 0.6deg, transparent 0.6deg 12deg); animation: ck-spin 40s linear infinite;`}></div>
            <div style="position: absolute; inset: 9px; border-radius: 50%; background: #080B10;"></div>
            <div style={`position: absolute; inset: 20px; border-radius: 50%; border: 1px solid transparent; border-top-color: ${accent}; border-right-color: ${glowSoft}; animation: ck-spin 6.5s linear infinite;`}></div>
            <div style={`position: absolute; inset: 40px; border-radius: 50%; border: 1px solid transparent; border-bottom-color: ${glowSoft}; animation: ck-spin-rev 10s linear infinite;`}></div>
            <div style="position: absolute; inset: 58px; border-radius: 50%; border: 1px dashed rgba(111,185,240,0.14); animation: ck-spin 26s linear infinite;"></div>
            <div style={`position: absolute; left: 50%; top: 50%; width: 180px; height: 180px; margin: -90px 0 0 -90px; border-radius: 50%; background: ${glowSoft}; filter: blur(46px); animation: ck-bloom 6s ease-in-out infinite;`}></div>
            <div style="position: relative; width: 190px; height: 95px; display: flex; align-items: center; justify-content: center;">
              <div style="position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 -92px; border-radius: 50%; border: 1px solid rgba(111,185,240,0.14);"></div>
              <div style="position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 0; border-radius: 50%; border: 1px solid rgba(111,185,240,0.14);"></div>
              <div style={`position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 -92px; border-radius: 50%; border: 1px solid transparent; border-top-color: ${glowStrong}; border-right-color: ${glowSoft}; animation: ck-spin 3.8s linear infinite;`}></div>
              <div style={`position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 0; border-radius: 50%; border: 1px solid transparent; border-top-color: ${glowStrong}; border-left-color: ${glowSoft}; animation: ck-spin-rev 3.8s linear infinite;`}></div>
              <div style="position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 -92px; animation: ck-spin 3.8s linear infinite;"><div style={`position: absolute; left: 100%; top: 50%; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%; background: #F7FBFF; box-shadow: 0 0 14px 4px ${glowStrong};`}></div></div>
              <div style="position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 0; animation: ck-spin-rev 3.8s linear infinite;"><div style={`position: absolute; left: 0; top: 50%; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%; background: #F7FBFF; box-shadow: 0 0 14px 4px ${glowStrong};`}></div></div>
              <span style={`position: relative; font-family: 'Noto Sans Javanese', serif; font-size: 54px; line-height: 1; display: block; transform: translateY(17.5%); color: #F7FBFF; text-shadow: 0 0 34px ${glowStrong};`}>ꦕ</span>
            </div>
          </div>
          <div style="position: absolute; left: 0; right: 0; bottom: 30px; display: flex; flex-direction: column; align-items: center; gap: 8px;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 18px; font-weight: 500; letter-spacing: 0.36em; text-indent: 0.36em; color: #F2F8FF;">caraka</span>
