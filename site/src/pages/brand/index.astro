    <section style="padding: 80px; border-bottom: 1px solid rgba(111,185,240,0.10);">
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.24em; color: #4E7EA6; margin-bottom: 12px;">12 · CADANGAN TANPA AKSARA</div>
      <p style="margin: 0 0 40px; font-size: 15px; line-height: 1.65; color: #8FAAC2; max-width: 680px; text-wrap: pretty;">Noto Sans Javanese belum terpasang default di banyak sistem. Tanpa cadangan, logo berubah jadi kotak tofu — jauh lebih merusak daripada mundur ke latin.</p>

      <div class="ck-m-cards" style="display: flex; gap: 24px;">
        <div style="flex: 1; background: #080B10; border: 1px solid rgba(111,185,240,0.10); border-radius: 14px; padding: 40px; display: flex; flex-direction: column; align-items: center; gap: 24px;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.18em; color: #4E7EA6; align-self: flex-start;">CADANGAN · MARK</div>
          <div style="position: relative; width: 186px; height: 93px; display: flex; align-items: center; justify-content: center; margin: 12px 0;">
            <div style={`position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 -92px; border-radius: 50%; border: 1.5px solid ${accent};`}></div>
            <div style={`position: absolute; left: 50%; top: 50%; width: 92px; height: 92px; margin: -46px 0 0 0; border-radius: 50%; border: 1.5px solid ${accent};`}></div>
            <span style="position: relative; font-family: 'JetBrains Mono', monospace; font-size: 44px; font-weight: 500; color: #F2F8FF;">c</span>
          </div>
