---
// Ported from design/mockups/Caraka OG Images.dc.html. Markup and inline styles are
// transcribed as-is; see site/AGENTS.md for the substitutions that replace the
// design-comp runtime.
import Base from '../../layouts/Base.astro'
import '../../styles/pages/og.css'
import '../../styles/mobile/og.css'
import { showGrid, showGuides, matrix, legend, toc, threats, term, phases, meta } from '../../data/og'
---

<Base page="og">
  <div class="ck-m-shell" style="width: 1424px; margin: 0 auto; padding: 0 0 120px; background: #05080C; font-family: 'Public Sans', sans-serif; color: #E9EDF2;">

    <main id="main">

    <section style="padding: 80px 112px 64px;">
      <div class="ck-m-stack" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.24em; color: #7A848F;">CARAKA · OPEN GRAPH</div>
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; color: #5D666F;">1200 × 630 · 7 HALAMAN</div>
      </div>

      <div class="ck-m-stack" style="display: flex; gap: 56px; align-items: flex-start;">
        <div style="flex: 1;">
          <h1 style="margin: 0 0 16px; font-size: 40px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.08; color: #F6F9FC; text-wrap: pretty;">Satu kerangka, tujuh isi</h1>
          <p style="margin: 0 0 14px; font-size: 15.5px; line-height: 1.7; color: #95A0AB; text-wrap: pretty;">Setiap kartu memakai rangka yang identik — <strong style="color:#D2D8DF;font-weight:600;">bilah bab</strong> di atas, kolom teks di kiri, <strong style="color:#D2D8DF;font-weight:600;">panel instrumen</strong> di kanan, lockup ꦕ di kaki. Yang berubah cuma kalimatnya dan satu motif. Di timeline Twitter atau preview Telegram, yang orang lihat pertama adalah judul; motif hanya memberi tanda halaman mana ini.</p>
          <p style="margin: 0; font-size: 15.5px; line-height: 1.7; color: #95A0AB; text-wrap: pretty;">Bilah di ujung atas terisi sesuai posisi halaman dalam urutan situs — kartu Landing terisi seperdelapan, kartu Status hampir penuh. Sinyal kecil, tapi konsisten di semua tempat kartu ini muncul.</p>
        </div>
        <div class="ck-m-fixw" style="width: 360px; flex-shrink: 0; background: #0C1116; border: 1px solid #171C22; border-radius: 12px; padding: 26px 28px;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.18em; color: #7A848F; margin-bottom: 18px;">ATURAN</div>
          <div style="display: flex; flex-direction: column; gap: 13px; font-size: 13.5px; line-height: 1.5; color: #B2BCC6;">
            <div style="display: flex; gap: 11px;"><span style="color: #FF7A5E;">→</span><span><strong style="color:#F6F9FC;font-weight:600;">Judul maksimal dua baris.</strong> 58px, tidak pernah mengecil untuk memuat kalimat panjang — kalimatnya yang dipendekkan.</span></div>
            <div style="display: flex; gap: 11px;"><span style="color: #FF7A5E;">→</span><span><strong style="color:#F6F9FC;font-weight:600;">Padding aman 72px.</strong> LinkedIn dan Telegram memotong tepi; tidak ada yang penting di luar itu.</span></div>
            <div style="display: flex; gap: 11px;"><span style="color: #FF7A5E;">→</span><span><strong style="color:#F6F9FC;font-weight:600;">Motif tidak boleh membawa informasi baru.</strong> Ia mengulang isi halaman, bukan menambah.</span></div>
            <div style="display: flex; gap: 11px;"><span style="color: #FF7A5E;">→</span><span><strong style="color:#F6F9FC;font-weight:600;">Tiga fakta mono</strong> di kaki teks. Bukan empat, bukan kalimat.</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="ck-m-cardsec" style="padding: 0 112px 56px;">
      <div class="ck-m-caphead" style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 16px;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: #FF7A5E;">01 · LANDING</span>
        <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent);"></span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: #5D666F;">og-landing.png</span>
      </div>

      <div style="position: relative; width: 1200px; height: 630px; overflow: hidden; background: #05080C; border-radius: 4px;">
        {showGrid && (
          <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(226,69,44,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(226,69,44,.055) 1px, transparent 1px); background-size: 34px 34px; mask-image: radial-gradient(ellipse 66% 62% at 76% 48%, #000 12%, transparent 72%); -webkit-mask-image: radial-gradient(ellipse 66% 62% at 76% 48%, #000 12%, transparent 72%);"></div>
        )}
        <div style="position: absolute; right: -110px; top: 50%; width: 760px; height: 760px; margin-top: -380px; border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.16), transparent 62%);"></div>
        <div style="position: absolute; left: 0; right: 0; top: 0; height: 3px; background: #171C22;"></div>
        <div style="position: absolute; left: 0; top: 0; width: 12.5%; height: 3px; background: linear-gradient(90deg, #E2452C, #FF7A5E);"></div>

        <div style="position: absolute; inset: 0; padding: 72px; display: flex; align-items: center; gap: 56px;">
          <div style="flex: 1; display: flex; flex-direction: column; align-items: flex-start;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 26px;">
              <span style="width: 22px; height: 1px; background: #E2452C;"></span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.22em; color: #E2452C;">TELEGRAM → CODING AGENT</span>
            </div>
            <h2 style="margin: 0 0 22px; font-size: 58px; font-weight: 700; letter-spacing: -0.035em; line-height: 1.04; color: #F6F9FC;">Send the task.<br /><span style="color: #FF7A5E;">Caraka runs it.</span></h2>
            <p style="margin: 0 0 34px; max-width: 520px; font-size: 19px; line-height: 1.6; color: #95A0AB; text-wrap: pretty;">A thin bridge from Telegram to the coding agent already installed on your machine.</p>
            <div style="display: flex; align-items: center; gap: 16px; font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.14em; color: #7A848F;">
              {/* Comp line 73 counts the ACP registry; v0.2 drives one agent (scripts/gen-assets.mjs:552). */}
              <span>MIT</span><span style="color: #292E35;">·</span><span>NODE ≥ 22</span><span style="color: #292E35;">·</span><span>CLAUDE CODE</span>
            </div>
          </div>

          <div style="width: 348px; height: 348px; flex-shrink: 0; position: relative; display: flex; align-items: center; justify-content: center;">
            <div style="position: absolute; inset: 0; border-radius: 50%; background: repeating-conic-gradient(from 0deg, rgba(226,69,44,.28) 0deg .6deg, transparent .6deg 12deg);"></div>
            <div style="position: absolute; inset: 11px; border-radius: 50%; background: #05080C;"></div>
            <div style="position: absolute; inset: 24px; border-radius: 50%; border: 1.5px solid transparent; border-top-color: #E2452C; border-right-color: rgba(226,69,44,.3);"></div>
            <div style="position: absolute; inset: 52px; border-radius: 50%; border: 1.5px solid transparent; border-bottom-color: rgba(226,69,44,.32);"></div>
            <div style="position: absolute; inset: 76px; border-radius: 50%; border: 1px dashed rgba(226,69,44,.16);"></div>
            <div style="position: relative; width: 150px; height: 75px; display: flex; align-items: center; justify-content: center;">
              <div style="position: absolute; left: 0; top: 0; width: 75px; height: 75px; border-radius: 50%; border: 1.5px solid rgba(226,69,44,.22);"></div>
              <div style="position: absolute; right: 0; top: 0; width: 75px; height: 75px; border-radius: 50%; border: 1.5px solid rgba(226,69,44,.22);"></div>
              <div style="position: absolute; left: 0; top: 0; width: 75px; height: 75px; border-radius: 50%; border: 1.5px solid transparent; border-top-color: rgba(226,69,44,.7);"></div>
              <div style="position: absolute; right: 0; top: 0; width: 75px; height: 75px; border-radius: 50%; border: 1.5px solid transparent; border-bottom-color: rgba(226,69,44,.7);"></div>
              <span style="position: relative; font-family: 'Noto Sans Javanese', serif; font-size: 62px; line-height: 1; display: block; transform: translateY(17.5%); color: #F6F9FC; text-shadow: 0 0 40px rgba(226,69,44,.7);">ꦕ</span>
            </div>
          </div>
        </div>

        <div style="position: absolute; left: 72px; bottom: 56px; display: flex; align-items: center; gap: 13px;">
          <span style="width: 32px; height: 32px; border-radius: 8px; background: #E2452C; display: flex; align-items: center; justify-content: center;"><span style="font-family: 'Noto Sans Javanese', serif; font-size: 19px; line-height: 1; display: block; transform: translateY(17.5%); color: #FFEDE7;">ꦕ</span></span>
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 15px; letter-spacing: 0.2em; color: #E9EDF2;">caraka</span>
          <span style="width: 1px; height: 16px; background: #292E35;"></span>
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #5D666F;">caraka.dev</span>
        </div>
        <div style="position: absolute; right: 72px; bottom: 56px; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #414950;">/</div>

        {showGuides && (
          <div style="position: absolute; inset: 0; pointer-events: none;">
            <div style="position: absolute; inset: 72px; border: 1px dashed rgba(142,238,152,.4);"></div>
            <div style="position: absolute; left: 285px; top: 0; width: 630px; height: 630px; border-left: 1px dashed rgba(255,214,126,.35); border-right: 1px dashed rgba(255,214,126,.35);"></div>
            <span style="position: absolute; left: 78px; top: 78px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.16em; color: #8EEE98;">SAFE 72px</span>
            <span style="position: absolute; left: 292px; bottom: 8px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.16em; color: #FFD67E;">POTONGAN 1:1</span>
          </div>
        )}
      </div>
    </section>

    <section class="ck-m-cardsec" style="padding: 0 112px 56px;">
      <div class="ck-m-caphead" style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 16px;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: #FF7A5E;">02 · COMPARE</span>
        <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent);"></span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: #5D666F;">og-compare.png</span>
      </div>

      <div style="position: relative; width: 1200px; height: 630px; overflow: hidden; background: #05080C; border-radius: 4px;">
        {showGrid && (
          <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(226,69,44,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(226,69,44,.055) 1px, transparent 1px); background-size: 34px 34px; mask-image: radial-gradient(ellipse 66% 62% at 76% 48%, #000 12%, transparent 72%); -webkit-mask-image: radial-gradient(ellipse 66% 62% at 76% 48%, #000 12%, transparent 72%);"></div>
        )}
        <div style="position: absolute; right: -110px; top: 50%; width: 760px; height: 760px; margin-top: -380px; border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.13), transparent 62%);"></div>
        <div style="position: absolute; left: 0; right: 0; top: 0; height: 3px; background: #171C22;"></div>
        <div style="position: absolute; left: 0; top: 0; width: 25%; height: 3px; background: linear-gradient(90deg, #E2452C, #FF7A5E);"></div>

        <div style="position: absolute; inset: 0; padding: 72px; display: flex; align-items: center; gap: 52px;">
          <div style="flex: 1; display: flex; flex-direction: column; align-items: flex-start;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 26px;">
              <span style="width: 22px; height: 1px; background: #E2452C;"></span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.22em; color: #E2452C;">COMPARE</span>
            </div>
            {/* Comp line 133 claims a hub for agents; nothing at v0.2 is one, so the card carries the compare ogHeadline (src/lib/site.ts:105). */}
            <h2 style="margin: 0 0 22px; font-size: 58px; font-weight: 700; letter-spacing: -0.035em; line-height: 1.04; color: #F6F9FC;">Where the two shapes<br /><span style="color: #FF7A5E;">actually differ.</span></h2>
            <p style="margin: 0 0 34px; max-width: 470px; font-size: 19px; line-height: 1.6; color: #95A0AB; text-wrap: pretty;">Where Caraka overlaps with OpenClaw and Hermes — and where it deliberately does not.</p>
            <div style="display: flex; align-items: center; gap: 16px; font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.14em; color: #7A848F;">
              <span>SCOPE</span><span style="color: #292E35;">·</span><span>OWNERSHIP</span><span style="color: #292E35;">·</span><span>SURFACE</span>
            </div>
          </div>

          <div style="width: 400px; flex-shrink: 0; background: #0C1116; border: 1px solid #171C22; border-radius: 14px; overflow: hidden;">
            <div style="display: grid; grid-template-columns: 1fr 62px 62px 62px; align-items: center; padding: 15px 20px; background: #171C22; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 0.13em; color: #7A848F;">
              <span></span><span style="text-align: center; color: #FF7A5E;">CRK</span><span style="text-align: center;">OCW</span><span style="text-align: center;">HRM</span>
            </div>
            {matrix.map((m) => (
              <div style="display: grid; grid-template-columns: 1fr 62px 62px 62px; align-items: center; padding: 14px 20px; border-top: 1px solid #171C22; font-size: 13.5px; color: #B2BCC6;">
                <span>{m.row}</span>
                <span style="text-align: center; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #8EEE98;">{m.a}</span>
                <span style="text-align: center; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #5D666F;">{m.b}</span>
                <span style="text-align: center; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #5D666F;">{m.c}</span>
              </div>
            ))}
          </div>
        </div>

        <div style="position: absolute; left: 72px; bottom: 56px; display: flex; align-items: center; gap: 13px;">
          <span style="width: 32px; height: 32px; border-radius: 8px; background: #E2452C; display: flex; align-items: center; justify-content: center;"><span style="font-family: 'Noto Sans Javanese', serif; font-size: 19px; line-height: 1; display: block; transform: translateY(17.5%); color: #FFEDE7;">ꦕ</span></span>
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 15px; letter-spacing: 0.2em; color: #E9EDF2;">caraka</span>
          <span style="width: 1px; height: 16px; background: #292E35;"></span>
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #5D666F;">caraka.dev</span>
        </div>
        <div style="position: absolute; right: 72px; bottom: 56px; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #414950;">/compare</div>

        {showGuides && (
          <div style="position: absolute; inset: 0; pointer-events: none;">
            <div style="position: absolute; inset: 72px; border: 1px dashed rgba(142,238,152,.4);"></div>
            <div style="position: absolute; left: 285px; top: 0; width: 630px; height: 630px; border-left: 1px dashed rgba(255,214,126,.35); border-right: 1px dashed rgba(255,214,126,.35);"></div>
          </div>
        )}
      </div>
    </section>

    <section class="ck-m-cardsec" style="padding: 0 112px 56px;">
      <div class="ck-m-caphead" style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 16px;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: #FF7A5E;">03 · STORY</span>
        <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent);"></span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: #5D666F;">og-story.png</span>
      </div>

      <div style="position: relative; width: 1200px; height: 630px; overflow: hidden; background: #05080C; border-radius: 4px;">
        <div style="position: absolute; right: -40px; top: 50%; width: 700px; height: 700px; margin-top: -350px; border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.18), transparent 60%);"></div>
        <div style="position: absolute; left: 0; right: 0; top: 0; height: 3px; background: #171C22;"></div>
        <div style="position: absolute; left: 0; top: 0; width: 37.5%; height: 3px; background: linear-gradient(90deg, #E2452C, #FF7A5E);"></div>

        <div style="position: absolute; inset: 0; padding: 72px; display: flex; align-items: center; gap: 52px;">
          <div style="flex: 1; display: flex; flex-direction: column; align-items: flex-start;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 26px;">
              <span style="width: 22px; height: 1px; background: #E2452C;"></span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.22em; color: #E2452C;">STORY · HANACARAKA</span>
            </div>
            <h2 style="margin: 0 0 22px; font-size: 58px; font-weight: 700; letter-spacing: -0.035em; line-height: 1.04; color: #F6F9FC;">Two envoys,<br /><span style="color: #FF7A5E;">equally strong.</span></h2>
            <p style="margin: 0 0 34px; max-width: 470px; font-size: 19px; line-height: 1.6; color: #95A0AB; text-wrap: pretty;">A Javanese legend about a message that never arrived — mapped line by line onto the architecture.</p>
            <div style="display: flex; align-items: center; gap: 16px; font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.14em; color: #7A848F;">
              <span>20 AKSARA</span><span style="color: #292E35;">·</span><span>4 BARIS</span><span style="color: #292E35;">·</span><span>1 ARSITEKTUR</span>
            </div>
          </div>

          <div style="width: 420px; flex-shrink: 0; display: flex; flex-direction: column; gap: 18px;">
            {legend.map((l) => (
              <div style="display: flex; align-items: center; gap: 18px;">
                <span style={`font-family: 'Noto Sans Javanese', serif; font-size: 34px; line-height: 1.5; display: block; color: ${l.ink}; white-space: nowrap;`}>{l.aksara}</span>
                <span style="flex: 1; height: 1px; background: #171C22;"></span>
                <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.1em; color: #5D666F; text-align: right; width: 118px; flex-shrink: 0;">{l.gloss}</span>
              </div>
            ))}
          </div>
        </div>

        <div style="position: absolute; left: 72px; bottom: 56px; display: flex; align-items: center; gap: 13px;">
          <span style="width: 32px; height: 32px; border-radius: 8px; background: #E2452C; display: flex; align-items: center; justify-content: center;"><span style="font-family: 'Noto Sans Javanese', serif; font-size: 19px; line-height: 1; display: block; transform: translateY(17.5%); color: #FFEDE7;">ꦕ</span></span>
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 15px; letter-spacing: 0.2em; color: #E9EDF2;">caraka</span>
          <span style="width: 1px; height: 16px; background: #292E35;"></span>
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #5D666F;">caraka.dev</span>
        </div>
        <div style="position: absolute; right: 72px; bottom: 56px; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #414950;">/story</div>

        {showGuides && (
          <div style="position: absolute; inset: 0; pointer-events: none;">
            <div style="position: absolute; inset: 72px; border: 1px dashed rgba(142,238,152,.4);"></div>
            <div style="position: absolute; left: 285px; top: 0; width: 630px; height: 630px; border-left: 1px dashed rgba(255,214,126,.35); border-right: 1px dashed rgba(255,214,126,.35);"></div>
          </div>
        )}
      </div>
    </section>

    <section class="ck-m-cardsec" style="padding: 0 112px 56px;">
      <div class="ck-m-caphead" style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 16px;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: #FF7A5E;">04 · DOCS</span>
        <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent);"></span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: #5D666F;">og-docs.png</span>
      </div>

      <div style="position: relative; width: 1200px; height: 630px; overflow: hidden; background: #05080C; border-radius: 4px;">
        {showGrid && (
          <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(226,69,44,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(226,69,44,.055) 1px, transparent 1px); background-size: 34px 34px; mask-image: radial-gradient(ellipse 66% 62% at 76% 48%, #000 12%, transparent 72%); -webkit-mask-image: radial-gradient(ellipse 66% 62% at 76% 48%, #000 12%, transparent 72%);"></div>
        )}
        <div style="position: absolute; right: -110px; top: 50%; width: 760px; height: 760px; margin-top: -380px; border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.12), transparent 62%);"></div>
        <div style="position: absolute; left: 0; right: 0; top: 0; height: 3px; background: #171C22;"></div>
        <div style="position: absolute; left: 0; top: 0; width: 50%; height: 3px; background: linear-gradient(90deg, #E2452C, #FF7A5E);"></div>

        <div style="position: absolute; inset: 0; padding: 72px; display: flex; align-items: center; gap: 52px;">
          <div style="flex: 1; display: flex; flex-direction: column; align-items: flex-start;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 26px;">
              <span style="width: 22px; height: 1px; background: #E2452C;"></span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.22em; color: #E2452C;">DOCS</span>
            </div>
