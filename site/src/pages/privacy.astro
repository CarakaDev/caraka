---
// The privacy policy, on the site. It renders docs/privacy.md and
// docs/privacy.id.md through src/lib/policy.ts, so the page is those files and
// holds no sentence of its own beyond the two language labels below.
//
// There is no design comp for this route. It borrows the shapes and the
// stylesheet of the security page the way /whatsapp-risk does, so the two keep
// one set of keyframe values. The English text comes first because the site
// declares lang="en"; the Indonesian text is a second block on the same page,
// marked lang="id" on its own wrapper.
import Base from '../layouts/Base.astro'
import SiteHeader from '../components/SiteHeader.astro'
import MobileToc from '../components/MobileToc.astro'
import PolicyText from '../components/PolicyText.astro'
import '../styles/pages/security.css'
import { parsePolicy } from '../lib/policy'
import { SITE } from '../lib/site'
import enMd from '../../../docs/privacy.md?raw'
import idMd from '../../../docs/privacy.id.md?raw'

const en = parsePolicy(enMd)
const id = parsePolicy(idMd)

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
const no = (i: number) => String(i + 1).padStart(2, '0')

const toc = [
  ...en.sections.map((s, i) => ({ no: no(i), title: s.title, href: `#en-${slug(s.title)}` })),
  { no: 'ID', title: 'Bahasa Indonesia', href: '#id' },
]

const blocks = [
  { lang: 'en', policy: en, prefix: 'en' },
  { lang: 'id', policy: id, prefix: 'idn' },
] as const

const SOURCE = `${SITE.repo}/blob/main/docs/privacy.md`
const rise = 'animation: ck-rise linear both; animation-timeline: view();'
---

<Base page="privacy">
  <div style="width: 100%; background: #05080C; font-family: 'Public Sans', sans-serif; color: #E9EDF2; position: relative; overflow-x: hidden;">

    <div aria-hidden="true" style="position: fixed; left: 0; top: 0; right: 0; height: 2px; z-index: 110; background: #171C22;">
      <div style="height: 100%; width: 100%; background: linear-gradient(90deg, #E2452C, #FF7A5E); transform-origin: left; transform: scaleX(var(--ck-sp, 0));"></div>
    </div>

    <SiteHeader badge="PRIVACY" active="/privacy" cta={{ label: 'Source ↗', href: SOURCE }} />

    <section id="main" style="position: relative; padding: clamp(118px, 17vh, 172px) clamp(20px, 5vw, 60px) clamp(50px, 7vh, 80px); overflow: hidden;">
      <div aria-hidden="true" style="position: absolute; left: 50%; top: 30%; width: min(760px, 120vw); height: min(760px, 120vw); margin-left: min(-380px, -60vw); margin-top: min(-380px, -60vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.11), transparent 62%); animation: ck-bloom 8s ease-in-out infinite; pointer-events: none;"></div>
      <div style="position: relative; width: min(1120px, 100%); margin: 0 auto;">
        <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; animation: ck-boot .8s cubic-bezier(.2,.9,.3,1) both;">
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">PRIVACY</span>
          <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX 1s cubic-bezier(.3,.7,.3,1) .25s both;"></span>
        </div>
        <h1 style="margin: 0 0 20px; max-width: 880px; font-size: clamp(30px, 5.4vw, 56px); font-weight: 700; letter-spacing: -.03em; line-height: 1.08; color: #F6F9FC; text-wrap: balance; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .15s both;">{en.title}</h1>
        {en.intro.map((p) => (
          <p style="margin: 0 0 14px; max-width: 660px; font-size: clamp(15px, 1.9vw, 18px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .28s both;"><PolicyText parts={p} /></p>
        ))}
        <p style="margin: 0; max-width: 760px; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; line-height: 1.8; color: #5D666F; overflow-wrap: anywhere; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) .34s both;"><PolicyText parts={en.meta} /></p>
      </div>
    </section>

    <div style="display: flex; gap: clamp(28px, 4vw, 56px); width: min(1240px, 100%); margin: 0 auto; padding: clamp(30px, 5vh, 60px) clamp(20px, 4vw, 44px) clamp(70px, 12vh, 120px);">
      <main style="flex: 1; min-width: 0;">
        <MobileToc chapters={toc} breakpoint={1080} />

        {blocks.map((b) => (
          <div id={b.lang === 'id' ? 'id' : undefined} lang={b.lang === 'id' ? 'id' : undefined} style="scroll-margin-top: 90px;">
            {b.lang === 'id' && (
              <div style="margin: 0 0 clamp(36px, 6vh, 60px); padding-top: clamp(36px, 6vh, 60px); border-top: 1px solid #171C22;">
                <h2 style="margin: 0 0 18px; max-width: 880px; font-size: clamp(26px, 4.4vw, 44px); font-weight: 700; letter-spacing: -.03em; line-height: 1.1; color: #F6F9FC; text-wrap: balance;">{id.title}</h2>
                {id.intro.map((p) => (
                  <p style="margin: 0 0 14px; max-width: 660px; font-size: 16px; line-height: 1.7; color: #95A0AB; text-wrap: pretty;"><PolicyText parts={p} /></p>
                ))}
                <p style="margin: 0; max-width: 760px; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; line-height: 1.8; color: #5D666F; overflow-wrap: anywhere;"><PolicyText parts={id.meta} /></p>
              </div>
            )}
            {b.policy.sections.map((s, i) => (
              <section id={`${b.prefix}-${slug(s.title)}`} style="margin-bottom: clamp(40px, 7vh, 68px); scroll-margin-top: 90px;">
                <div style={`display: flex; align-items: baseline; gap: 13px; margin-bottom: 12px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 80%;`}>
                  <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #E2452C;">{no(i)}</span>
                  <h2 style="margin: 0; font-size: clamp(20px, 2.8vw, 28px); font-weight: 700; letter-spacing: -.02em; color: #F6F9FC;">{s.title}</h2>
                </div>
                {s.blocks.map((blk) =>
                  blk.kind === 'p' ? (
                    <p style={`margin: 0 0 14px; max-width: 660px; font-size: 15px; line-height: 1.7; color: #95A0AB; text-wrap: pretty; ${rise} animation-range: entry 0% cover 24%;`}><PolicyText parts={blk.inline} /></p>
                  ) : (
                    <div style="margin: 0 0 14px; max-width: 660px; display: flex; flex-direction: column; gap: 10px;">
                      {blk.items.map((it) => (
                        <div style="display: flex; gap: 13px;">
                          <span style="color: #FF93B2; font-family: 'JetBrains Mono', monospace; font-size: 12px; flex-shrink: 0; padding-top: 3px;">·</span>
                          <span style="font-size: 15px; line-height: 1.7; color: #95A0AB; text-wrap: pretty;"><PolicyText parts={it} /></span>
                        </div>
                      ))}
                    </div>
                  ),
                )}
              </section>
            ))}
          </div>
        ))}
      </main>

      <aside data-toc="1" style="width: 186px; flex-shrink: 0;">
        <div style="position: sticky; top: 104px; display: flex; flex-direction: column; gap: 2px;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .2em; color: #414950; margin-bottom: 12px;">ON THIS PAGE</div>
          {toc.map((t) => (
            <a href={t.href} class="hv-ring-ink" style="display: flex; align-items: baseline; gap: 9px; padding: 7px 0 7px 12px; border-left: 1px solid #171C22; font-size: 12.5px; color: #7A848F; transition: color .2s, border-color .2s;">
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #414950;">{t.no}</span><span>{t.title}</span>
            </a>
          ))}
        </div>
      </aside>
    </div>

    <footer style="padding: clamp(44px, 7vh, 70px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1240px, 100%); margin: 0 auto; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #414950;">ꦕ caraka · {SITE.contact}</span>
        <div style="display: flex; flex-wrap: wrap; gap: clamp(14px, 2.6vw, 28px); font-family: 'JetBrains Mono', monospace; font-size: 12.5px;">
          <a href="/" class="hv-ink" style="color: #7A848F;">Home</a>
          <a href="/docs" class="hv-ink" style="color: #7A848F;">Docs</a>
          <a href="/security" class="hv-ink" style="color: #7A848F;">Security</a>
          <a href={SOURCE} class="hv-ink" style="color: #7A848F;">privacy.md</a>
        </div>
      </div>
    </footer>
  </div>
</Base>
