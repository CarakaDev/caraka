---
// Ported from design/mockups/Caraka Landing.dc.html. Markup and inline styles
// are transcribed as-is; see site/AGENTS.md for the five substitutions that
// replace the design-comp runtime.
import Base from '../layouts/Base.astro'
import GapVisual from '../components/GapVisual.astro'
import '../styles/pages/landing.css'
import { nav, gaps, states, topics, agents, layers, mem, safety, term, verse, footerLinks } from '../data/landing'
---

<Base page="landing">
  <div style="width: 100%; background: #05080C; font-family: 'Public Sans', sans-serif; color: #E9EDF2; position: relative; overflow-x: hidden;">

    {/* The opening veil. In the mockup a timer unmounts it; here ck-veil ends on
        visibility: hidden, so CSS retires it and no script is needed. */}
    <div aria-hidden="true" style="position: fixed; inset: 0; z-index: 300; background: #05080C; display: flex; align-items: center; justify-content: center; animation: ck-veil 2.6s cubic-bezier(.65,0,.2,1) forwards; pointer-events: none;">
      <div style="position: relative; width: 260px; height: 260px;">
        <div style="position: absolute; left: 50%; top: 50%; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: #E2452C; box-shadow: 0 0 30px 10px rgba(226,69,44,.55); animation: ck-seed .5s cubic-bezier(.2,1.4,.4,1) both, ck-fade .3s .7s reverse both;"></div>
        <div style="position: absolute; left: 50%; top: 50%; width: 108px; height: 108px; margin: -54px 0 0 -108px; border-radius: 50%; border: 1.5px solid #E2452C; animation: ck-ringIn .65s cubic-bezier(.2,1.25,.4,1) .28s both, ck-partL 1s cubic-bezier(.6,0,.15,1) 1.55s both;"></div>
        <div style="position: absolute; left: 50%; top: 50%; width: 108px; height: 108px; margin: -54px 0 0 0; border-radius: 50%; border: 1.5px solid #E2452C; animation: ck-ringIn .65s cubic-bezier(.2,1.25,.4,1) .28s both, ck-partR 1s cubic-bezier(.6,0,.15,1) 1.55s both;"></div>
        <div style="position: absolute; left: 50%; top: 50%; width: 3px; height: 250px; margin: -125px 0 0 -1.5px; background: #FFF3F0; box-shadow: 0 0 32px 7px rgba(226,69,44,.8); transform-origin: center; animation: ck-seam 1.25s cubic-bezier(.6,0,.3,1) .95s both;"></div>
        <span style="position: absolute; left: 50%; top: 50%; font-family: 'Noto Sans Javanese', serif; font-size: 60px; line-height: 1; color: #F6F9FC; text-shadow: 0 0 38px rgba(226,69,44,.85); animation: ck-glyphIn .6s cubic-bezier(.2,.9,.3,1) .72s both, ck-glyphOut .75s cubic-bezier(.5,0,.3,1) 1.6s both;">ꦕ</span>
      </div>
      <div style="position: absolute; left: 50%; bottom: 12vh; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 12px;">
        <div style="width: 132px; height: 1px; background: #171C22; overflow: hidden;">
          <div style="width: 100%; height: 100%; background: #E2452C; transform-origin: left; animation: ck-bootbar 1.9s cubic-bezier(.3,.7,.3,1) both;"></div>
        </div>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 9.5px; letter-spacing: .3em; color: #414950; animation: ck-fade .6s .35s both;">MEMBUKA GERBANG</span>
      </div>
    </div>

    <header style="position: fixed; left: 0; right: 0; top: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 14px clamp(16px, 4vw, 34px); background: rgba(5,8,12,.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid #0C1116; animation: ck-fade .8s 2.5s both;">
      <a href="#hero" style="display: flex; align-items: center; gap: 12px;">
        <span style="position: relative; width: 44px; height: 22px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <span style="position: absolute; left: 50%; top: 50%; width: 21px; height: 21px; margin: -10.5px 0 0 -21px; border-radius: 50%; border: 1px solid #E2452C;"></span>
          <span style="position: absolute; left: 50%; top: 50%; width: 21px; height: 21px; margin: -10.5px 0 0 0; border-radius: 50%; border: 1px solid #E2452C;"></span>
          <span style="position: relative; font-family: 'Noto Sans Javanese', serif; font-size: 12px; line-height: 1; display: block; transform: translateY(17.5%); color: #F6F9FC;">ꦕ</span>
        </span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .2em; color: #E9EDF2;">caraka</span>
      </a>
      <nav data-navlinks="1" style="align-items: center; gap: clamp(14px, 2.4vw, 26px); font-family: 'JetBrains Mono', monospace; font-size: 12px;">
        <a href="/docs" class="hv-ink" style="color: #7A848F;">Docs</a>
        <a href="/install" class="hv-ink" style="color: #7A848F;">Install</a>
        <a href="/compare" class="hv-ink" style="color: #7A848F;">Compare</a>
        <a href="/security" class="hv-ink" style="color: #7A848F;">Security</a>
      </nav>
      <a href="https://github.com/CarakaDev/caraka" class="hv-ring-ink" style="padding: 9px 16px; border: 1px solid #292E35; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #B2BCC6; transition: border-color .2s, color .2s; white-space: nowrap;">GitHub ↗</a>
    </header>

    <div data-topbar="1" style="position: fixed; left: 0; top: 0; right: 0; height: 2px; z-index: 110; background: #171C22;">
      <div style="height: 100%; width: 100%; background: linear-gradient(90deg, #E2452C, #FF7A5E); transform-origin: left; transform: scaleX(var(--ck-sp, 0));"></div>
    </div>

    <div data-rail="1" style="position: fixed; right: 24px; top: 0; bottom: 0; z-index: 95; flex-direction: column; align-items: flex-end; justify-content: center; pointer-events: none; animation: ck-fade .8s 2.6s both;">
      <div style="position: relative; height: 44vh; width: 158px; display: flex; align-items: flex-start; justify-content: flex-end;">
        <div style="position: absolute; right: 6px; top: 0; bottom: 0; width: 1px; background: #171C22;"></div>
        <div style="position: absolute; right: 6px; top: 0; width: 1px; height: 100%; transform-origin: top; transform: scaleY(var(--ck-sp, 0)); background: linear-gradient(180deg, #E2452C, #FF7A5E);"></div>
        <div style="position: absolute; right: 1.5px; top: calc(var(--ck-sp, 0) * 100%); width: 11px; height: 11px; margin-top: -5.5px; border-radius: 50%; background: #FF7A5E; box-shadow: 0 0 15px 4px rgba(226,69,44,.7);"></div>
        <div style="position: absolute; right: 3.5px; top: calc((1 - var(--ck-sp, 0)) * 100%); width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: #5D666F;"></div>
        <div style="position: absolute; right: 0; top: 0; bottom: 0; width: 158px; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-end; pointer-events: auto;">
          {nav.map((s) => (
            <a href={s.href} style="display: flex; align-items: center; gap: 10px; padding: 3px 0;">
              <span class="hv-reveal" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .12em; color: #5D666F; opacity: 0; transition: opacity .25s, color .25s;">{s.label}</span>
              <span class="hv-tick" style="width: 13px; height: 1px; background: #414950; transition: background .25s, width .25s;"></span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <main id="main">

    <section id="hero" style="position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: clamp(96px, 12vh, 128px) clamp(20px, 5vw, 60px) clamp(96px, 12vh, 128px); overflow: hidden;">
      <div style="position: absolute; inset: -10% 0; background-image: linear-gradient(rgba(226,69,44,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(226,69,44,.05) 1px, transparent 1px); background-size: 34px 34px; animation: ck-drift 16s linear infinite; mask-image: radial-gradient(ellipse 78% 58% at 50% 45%, #000 18%, transparent 74%); -webkit-mask-image: radial-gradient(ellipse 78% 58% at 50% 45%, #000 18%, transparent 74%);"></div>
      <div style="position: absolute; left: 50%; top: 42%; width: min(700px, 115vw); height: min(700px, 115vw); margin-left: min(-350px, -57.5vw); margin-top: min(-350px, -57.5vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.17), transparent 62%); animation: ck-bloom 7s ease-in-out infinite; pointer-events: none;"></div>

      <div style="position: relative; width: min(1120px, 100%); display: flex; flex-direction: column; align-items: center; text-align: center; gap: clamp(20px, 2.8vh, 32px); animation: ck-heroOut linear both; animation-timeline: view(); animation-range: exit 20% exit 100%;">

        <div style="position: relative; width: clamp(200px, 28vw, 286px); height: clamp(200px, 28vw, 286px); display: flex; align-items: center; justify-content: center; animation: ck-zoom 1.1s cubic-bezier(.2,.9,.3,1) 2.2s both;">
          <div style="position: absolute; inset: 0; border-radius: 50%; background: repeating-conic-gradient(from 0deg, rgba(226,69,44,.3) 0deg .6deg, transparent .6deg 12deg); animation: ck-spin 42s linear infinite;"></div>
          <div style="position: absolute; inset: 9px; border-radius: 50%; background: #05080C;"></div>
          <div style="position: absolute; inset: 20px; border-radius: 50%; border: 1px solid transparent; border-top-color: #E2452C; border-right-color: rgba(226,69,44,.3); animation: ck-spin 6.5s linear infinite;"></div>
          <div style="position: absolute; inset: 42px; border-radius: 50%; border: 1px solid transparent; border-bottom-color: rgba(226,69,44,.32); animation: ck-spinRev 10s linear infinite;"></div>
          <div style="position: absolute; inset: 62px; border-radius: 50%; border: 1px dashed rgba(226,69,44,.16); animation: ck-spin 26s linear infinite;"></div>
          <div style="position: relative; width: 43%; height: 21.5%; display: flex; align-items: center; justify-content: center;">
            <div style="position: absolute; left: 50%; top: 50%; width: 100%; height: 200%; margin: -50% 0 0 -100%; border-radius: 50%; border: 1px solid rgba(226,69,44,.18);"></div>
            <div style="position: absolute; left: 50%; top: 50%; width: 100%; height: 200%; margin: -50% 0 0 0; border-radius: 50%; border: 1px solid rgba(226,69,44,.18);"></div>
            <div style="position: absolute; left: 50%; top: 50%; width: 100%; height: 200%; margin: -50% 0 0 -100%; border-radius: 50%; border: 1px solid transparent; border-top-color: rgba(226,69,44,.65); animation: ck-spin 3.8s linear infinite;"></div>
            <div style="position: absolute; left: 50%; top: 50%; width: 100%; height: 200%; margin: -50% 0 0 0; border-radius: 50%; border: 1px solid transparent; border-top-color: rgba(226,69,44,.65); animation: ck-spinRev 3.8s linear infinite;"></div>
            <span style="position: relative; font-family: 'Noto Sans Javanese', serif; font-size: clamp(40px, 5.6vw, 58px); line-height: 1; display: block; transform: translateY(17.5%); color: #F6F9FC; text-shadow: 0 0 38px rgba(226,69,44,.7);">ꦕ</span>
          </div>
        </div>

        <h1 style="margin: 0; font-size: clamp(34px, 6.2vw, 66px); font-weight: 700; letter-spacing: -.03em; line-height: 1.05; color: #F6F9FC; text-wrap: balance; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) 2.42s both;">Send the task.<br /><span style="color: #FF7A5E;">Caraka runs it.</span></h1>

        <p style="margin: 0; max-width: 620px; font-size: clamp(15px, 1.9vw, 19px); line-height: 1.65; color: #95A0AB; text-wrap: pretty; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) 2.55s both;">A thin bridge from Telegram to the coding agent already installed on your machine. Every task lives in its own topic — like tabs in a terminal — with approvals, streaming progress, and memory that can explain itself.</p>

        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) 2.68s both;">
          <button type="button" data-copy="npx caraka init" class="hv-ring-tint" style="display: flex; align-items: center; gap: 14px; padding: 15px 20px; background: #0C1116; border: 1px solid #292E35; border-radius: 11px; cursor: pointer; font-family: 'JetBrains Mono', monospace; font-size: clamp(13px, 1.6vw, 15px); color: #E9EDF2; transition: border-color .2s, background .2s;">
            <span style="color: #5D666F;">$</span><span>npx caraka init</span>
            <span data-copy-label="COPY" style="font-size: 11px; letter-spacing: .1em; color: #5D666F; min-width: 48px; text-align: right;">COPY</span>
          </button>
          <a href="/docs" class="hv-btn" style="display: flex; align-items: center; gap: 9px; padding: 15px 22px; background: #E2452C; border-radius: 11px; font-family: 'JetBrains Mono', monospace; font-size: clamp(13px, 1.6vw, 15px); font-weight: 500; color: #FFEDE7; transition: background .2s;">Read the docs →</a>
        </div>

        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: clamp(14px, 3vw, 26px); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .12em; color: #5D666F; animation: ck-fade 1s 2.85s both;">
          <span style="display: flex; align-items: center; gap: 8px;"><span style="position: relative; width: 6px; height: 6px; border-radius: 50%; background: #FFD67E;"><span style="position: absolute; inset: 0; border-radius: 50%; background: #FFD67E; animation: ck-pulse 2.4s ease-out infinite;"></span></span>PRE-ALPHA</span>
          <span>MIT</span><span>NODE ≥ 22</span><span>28+ AGENTS VIA ACP</span>
        </div>
      </div>

      <a href="#gap" class="hv-ring" aria-label="Scroll to the next section" style="position: absolute; left: 50%; bottom: 28px; margin-left: -14px; width: 28px; height: 44px; display: flex; align-items: flex-start; justify-content: center; padding-top: 8px; border: 1px solid #292E35; border-radius: 14px; animation: ck-fade 1s 3s both;">
        <span style="width: 3px; height: 8px; border-radius: 2px; background: #FF7A5E; animation: ck-blink 1.6s ease-in-out infinite;"></span>
      </a>
    </section>

    <section id="gap" style="position: relative; padding: clamp(84px, 15vh, 160px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; overflow: hidden;">
      <div style="position: absolute; left: -8%; top: 10%; width: min(460px, 70vw); height: min(460px, 70vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.07), transparent 65%); animation: ck-para linear both; animation-timeline: view(); animation-range: cover 0% cover 100%;"></div>
      <div style="position: relative; width: min(1120px, 100%); margin: 0 auto;">
        <div style="max-width: 760px; margin-bottom: clamp(40px, 6vh, 66px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 70%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">01 — THE GAP</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0; font-size: clamp(26px, 4.4vw, 44px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Your agent is brilliant. It just can't be reached.</h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(268px, 1fr)); gap: clamp(14px, 2vw, 22px);">
          {gaps.map((g) => (
            <div class="hv-card" style={`position: relative; padding: clamp(26px, 3vw, 34px); background: #0C1116; border: 1px solid #171C22; border-radius: 14px; display: flex; flex-direction: column; gap: 15px; overflow: hidden; transition: border-color .3s, transform .3s; animation: ck-rise linear both; animation-timeline: view(); animation-range: ${g.range};`}>
              <div style={`position: absolute; left: 0; top: 0; height: 1px; width: 60%; background: linear-gradient(90deg, transparent, #E2452C, transparent); animation: ck-sweepX 3.4s ease-in-out infinite; animation-delay: ${g.delay};`}></div>
              <div style="height: 74px; display: flex; align-items: center;"><GapVisual kind={g.visual} /></div>
              <h3 style="margin: 0; font-size: clamp(17px, 2vw, 20px); font-weight: 600; color: #F6F9FC; text-wrap: pretty;">{g.title}</h3>
              <p style="margin: 0; font-size: 14.5px; line-height: 1.65; color: #7A848F; text-wrap: pretty;">{g.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="tabs" style="position: relative; padding: clamp(84px, 15vh, 160px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; overflow: hidden;">
      <div style="position: absolute; right: -12%; top: 18%; width: min(640px, 92vw); height: min(640px, 92vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.11), transparent 66%); animation: ck-para linear both; animation-timeline: view(); animation-range: cover 0% cover 100%; pointer-events: none;"></div>
      <div style="position: relative; width: min(1120px, 100%); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); gap: clamp(34px, 5vw, 64px); align-items: center;">
        <div>
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 70%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">02 — SESSIONS ARE TABS</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0 0 20px; font-size: clamp(26px, 4.4vw, 44px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Chat is one flat stream. Work isn't.</h2>
          <p style="margin: 0 0 18px; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">Since 2026, Telegram bots can create forum topics <strong style="color: #D2D8DF; font-weight: 600;">inside a private chat, with no admin rights at all.</strong> That turns a DM with your bot into a tabbed workspace at zero setup cost.</p>
          <p style="margin: 0 0 26px; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 6% cover 32%;">Caraka names each topic, colours its icon by state, posts a closing summary, and closes it. The topic list becomes a status board you read at a glance — without opening anything.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 10px;">
            {states.map((s) => (
              <span style={`display: flex; align-items: center; gap: 8px; padding: 8px 13px; background: #0C1116; border: 1px solid #171C22; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #95A0AB; animation: ck-riseSm linear both; animation-timeline: view(); animation-range: ${s.range};`}>
                <span style={`color: ${s.color};`}>{s.glyph}</span>{s.name}
              </span>
            ))}
          </div>
        </div>

        <div style="background: #0C1116; border: 1px solid #171C22; border-radius: 16px; overflow: hidden; box-shadow: 0 30px 80px -30px rgba(0,0,0,.8); animation: ck-slideR linear both; animation-timeline: view(); animation-range: entry 0% cover 32%;">
          <div style="display: flex; align-items: center; gap: 11px; padding: 15px 18px; background: #171C22; border-bottom: 1px solid #292E35;">
            <span style="width: 26px; height: 26px; border-radius: 50%; background: #E2452C; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-family: 'Noto Sans Javanese', serif; font-size: 15px; line-height: 1; display: block; transform: translateY(17.5%); color: #FFEDE7;">ꦕ</span></span>
            <span style="font-size: 14px; font-weight: 600; color: #F6F9FC;">toko_caraka_bot</span>
            <span style="margin-left: auto; display: flex; align-items: center; gap: 7px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: #5D666F;"><span style="width: 5px; height: 5px; border-radius: 50%; background: #8EEE98; animation: ck-blink 2.6s ease-in-out infinite;"></span>3 aktif</span>
          </div>
          {topics.map((t) => (
            <div class="hv-tint" style={`position: relative; display: flex; align-items: center; gap: 13px; padding: 15px 18px; border-bottom: 1px solid #171C22; background: ${t.bg}; overflow: hidden; transition: background .25s; animation: ck-slideL linear both; animation-timeline: view(); animation-range: ${t.range};`}>
              <span style={`position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: ${t.color}; opacity: ${t.bar};`}></span>
              <span style={`position: relative; width: 9px; height: 9px; border-radius: 50%; background: ${t.color}; flex-shrink: 0;`}><span style={`position: absolute; inset: 0; border-radius: 50%; background: ${t.color}; opacity: ${t.bar}; animation: ck-pulse 2.8s ease-out infinite; animation-delay: ${t.delay};`}></span></span>
              <span style={`font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: ${t.color}; flex-shrink: 0;`}>{t.glyph}</span>
              <span style={`font-size: 13.5px; color: ${t.ink}; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;`}>{t.name}</span>
              <span style="margin-left: auto; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #5D666F; flex-shrink: 0;">{t.id}</span>
            </div>
          ))}
          <div style="padding: 15px 18px; display: flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #5D666F;">
            <span style="color: #FF7A5E;">▸</span><span>@toko-api kenapa checkout 500?</span>
            <span style="width: 6px; height: 12px; background: #FF7A5E; animation: ck-blink 1.1s step-end infinite;"></span>
          </div>
        </div>
      </div>
    </section>

    <section id="protocol" style="position: relative; padding: clamp(84px, 15vh, 160px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; overflow: hidden;">
      <div style="width: min(1120px, 100%); margin: 0 auto;">
        <div style="max-width: 780px; margin-bottom: clamp(36px, 5vh, 54px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 70%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">03 — ONE PROTOCOL</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0 0 18px; font-size: clamp(26px, 4.4vw, 44px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">No agent loop. No tools. No marketplace.</h2>
          <p style="margin: 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">Caraka speaks <a href="https://agentclientprotocol.com">ACP</a> — the LSP-equivalent for coding agents, created by Zed and co-led by JetBrains. Writing one client covers nearly every agent, including ones that don't exist yet. Sandboxing, permissions, and diff review are inherited, not rebuilt.</p>
        </div>

        <div style="position: relative; padding: clamp(24px, 3vw, 34px) 0 clamp(30px, 4vw, 42px); margin-bottom: clamp(28px, 4vh, 40px);">
          <div style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-bottom: 30px;">
            {agents.map((a) => (
              <span class="hv-chip" style={`padding: 9px 15px; background: #0C1116; border: 1px solid #171C22; border-radius: 100px; font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: #95A0AB; transition: border-color .25s, color .25s, transform .25s; animation: ck-zoom linear both; animation-timeline: view(); animation-range: ${a.range};`}>{a.n}</span>
            ))}
          </div>
          <div style="position: relative; height: 54px; display: flex; align-items: center; justify-content: center;">
            <div style="position: absolute; left: 15%; right: 15%; top: 0; height: 1px; background: linear-gradient(90deg, transparent, #2B1612 20%, #E2452C 50%, #2B1612 80%, transparent);"></div>
            <div style="position: absolute; left: 50%; top: -1px; width: 3px; height: 3px; margin-left: -1.5px; border-radius: 50%; background: #FF7A5E; box-shadow: 0 0 10px 3px rgba(226,69,44,.7);"></div>
            <div style="display: flex; align-items: center; gap: 12px; padding: 10px 20px; background: #12100F; border: 1px solid #2B1612; border-radius: 10px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #FF7A5E;">
              <span style="position: relative; width: 34px; height: 17px; display: flex; align-items: center; justify-content: center;">
                <span style="position: absolute; left: 50%; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 -16px; border-radius: 50%; border: 1px solid #E2452C;"></span>
                <span style="position: absolute; left: 50%; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 0; border-radius: 50%; border: 1px solid #E2452C;"></span>
                <span style="position: absolute; left: 50%; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 -16px; animation: ck-orbit 3.4s linear infinite;"><span style="position: absolute; left: 100%; top: 50%; width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 50%; background: #FF7A5E;"></span></span>
                <span style="position: absolute; left: 50%; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 0; animation: ck-spinRev 3.4s linear infinite;"><span style="position: absolute; left: 0; top: 50%; width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 50%; background: #FF7A5E;"></span></span>
              </span>
              caraka
            </div>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: clamp(14px, 2vw, 20px);">
          {layers.map((l) => (
            <div style={`position: relative; padding: clamp(24px, 3vw, 32px); background: ${l.bg}; border: 1px solid ${l.border}; border-radius: 14px; display: flex; flex-direction: column; gap: 11px; overflow: hidden; animation: ck-rise linear both; animation-timeline: view(); animation-range: ${l.range};`}>
              <div style={`position: absolute; left: 0; top: 0; height: 1px; width: 50%; background: linear-gradient(90deg, transparent, ${l.tone}, transparent); animation: ck-sweepX 4s ease-in-out infinite; animation-delay: ${l.delay};`}></div>
              <span style={`font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .18em; color: ${l.tone};`}>{l.tag}</span>
              <h3 style="margin: 0; font-size: 17px; font-weight: 600; color: #F6F9FC;">{l.title}</h3>
              <p style="margin: 0; font-size: 13.5px; line-height: 1.6; color: #7A848F; text-wrap: pretty;">{l.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="memory" style="position: relative; padding: clamp(84px, 15vh, 160px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1120px, 100%); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: clamp(34px, 5vw, 64px); align-items: center;">
        <div>
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 70%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">04 — MEMORY</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0 0 20px; font-size: clamp(26px, 4.4vw, 44px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Memory that can explain itself.</h2>
          <p style="margin: 0 0 18px; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">Caraka uses <a href="https://titen.dev">Titen</a>, which never flattens a conclusion into its evidence. Observations carry content hashes. Claims cite the observations they came from. Context records exactly what the agent was handed — and what the budget cut.</p>
          <p style="margin: 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 6% cover 32%;">Claim extraction is <strong style="color: #D2D8DF; font-weight: 600;">deterministic — no model in the loop.</strong> It works without an LLM by default, and <em>"why does it think that?"</em> always has an answer.</p>
        </div>
        <div style="position: relative; display: flex; flex-direction: column;">
          <div style="position: absolute; left: 17px; top: 20px; bottom: 96px; width: 1px; background: linear-gradient(180deg, #E2452C, #2B1612); transform-origin: top; animation: ck-drawY linear both; animation-timeline: view(); animation-range: entry 10% cover 46%;"></div>
          {mem.map((m) => (
            <div style={`position: relative; display: flex; gap: 18px; animation: ck-slideR linear both; animation-timeline: view(); animation-range: ${m.range};`}>
              <span style="width: 35px; height: 35px; flex-shrink: 0; border-radius: 50%; border: 1px solid #E2452C; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #FF7A5E; background: #05080C;">{m.n}</span>
              <div style="padding-bottom: 26px;">
                <div style="font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: #FF7A5E; margin-bottom: 6px;">{m.k}</div>
                <div style="font-size: 14.5px; line-height: 1.6; color: #95A0AB; text-wrap: pretty;">{m.v}</div>
              </div>
            </div>
          ))}
          <div style="margin-left: 53px; padding: 18px 20px; background: #12100F; border: 1px solid #2B1612; border-radius: 12px; font-family: 'JetBrains Mono', monospace; font-size: 12px; line-height: 1.9; color: #7A848F; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 14% cover 48%;">
            <div style="color: #FF7A5E;">claim_f3963d7b… <span style="color: #8EEE98;">verified</span></div>
            <div style="color: #B2BCC6;">"The p95 latency budget stays at 400 ms."</div>
            <div><span style="color: #5D666F;">supports</span> load-test-0714.json · p95 383 ms</div>
            <div><span style="color: #5D666F;">disputed</span> agent-11 says 250 ms · conf 0.44</div>
          </div>
        </div>
      </div>
    </section>

    <section id="safety" style="position: relative; padding: clamp(84px, 15vh, 160px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1120px, 100%); margin: 0 auto;">
        <div style="max-width: 760px; margin-bottom: clamp(38px, 5vh, 58px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 70%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">05 — SAFE BY DEFAULT</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0 0 18px; font-size: clamp(26px, 4.4vw, 44px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Deliberately boring out of the box.</h2>
          <p style="margin: 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">Caraka connects untrusted input to code execution on your machine. Chat text can never approve an action, change a policy, or raise a privilege.</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: clamp(12px, 1.6vw, 18px);">
          {safety.map((s) => (
            <div class="hv-ring-soft-row" style={`padding: 22px 24px; background: #0C1116; border: 1px solid #171C22; border-radius: 12px; display: flex; gap: 13px; align-items: flex-start; transition: border-color .25s, background .25s; animation: ck-riseSm linear both; animation-timeline: view(); animation-range: ${s.range};`}>
              <span style="color: #8EEE98; font-family: 'JetBrains Mono', monospace; font-size: 13px; flex-shrink: 0; padding-top: 1px;">✓</span>
              <span style="font-size: 14px; line-height: 1.55; color: #95A0AB; text-wrap: pretty;">{s.t}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="install" style="position: relative; padding: clamp(84px, 15vh, 160px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; overflow: hidden;">
      <div style="position: absolute; left: 50%; top: 50%; width: min(780px, 125vw); height: min(780px, 125vw); margin-left: min(-390px, -62.5vw); margin-top: min(-390px, -62.5vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.14), transparent 62%); animation: ck-bloom 8s ease-in-out infinite; pointer-events: none;"></div>
      <div style="position: relative; width: min(900px, 100%); margin: 0 auto; text-align: center;">
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C; margin-bottom: 18px; animation: ck-fade linear both; animation-timeline: view(); animation-range: entry 0% entry 65%;">06 — GET STARTED</div>
        <h2 style="margin: 0 0 18px; font-size: clamp(28px, 5vw, 50px); font-weight: 700; letter-spacing: -.03em; line-height: 1.1; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Under three minutes. Six interactions.</h2>
        <p style="margin: 0 auto clamp(30px, 4vh, 44px); max-width: 560px; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">No Docker. No repo to clone. No config file to write by hand. The wizard confirms what it finds instead of asking what it should already know.</p>

        <div style="position: relative; text-align: left; background: #05070A; border: 1px solid #171C22; border-radius: 14px; padding: clamp(20px, 3vw, 30px); font-family: 'JetBrains Mono', monospace; font-size: clamp(11.5px, 1.5vw, 13px); line-height: 2; color: #7A848F; overflow-x: auto; animation: ck-zoom linear both; animation-timeline: view(); animation-range: entry 2% cover 30%;">
          <div style="position: absolute; left: 0; right: 0; top: 0; height: 1px; background: linear-gradient(90deg, transparent, #E2452C, transparent); opacity: .5;"></div>
          {term.map((l) => (
            <div style={`display: flex; align-items: center; gap: 9px; flex-wrap: wrap; color: ${l.tone}; animation: ck-fade linear both; animation-timeline: view(); animation-range: ${l.range};`}>
              {l.mark && <span style={`color: ${l.markTone};`}>{l.mark}</span>}
              <span>{l.t}</span>
              {l.caret && <span style="width: 7px; height: 13px; background: #FF7A5E; animation: ck-blink 1.1s step-end infinite;"></span>}
            </div>
          ))}
        </div>

        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: clamp(26px, 4vh, 38px); animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 8% cover 36%;">
          <a href="https://github.com/CarakaDev/caraka" class="hv-btn" style="padding: 15px 26px; background: #E2452C; border-radius: 11px; font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 500; color: #FFEDE7; transition: background .2s;">Read the source →</a>
          <button type="button" data-copy="npx caraka init" class="hv-ring-ink" style="padding: 15px 26px; background: transparent; border: 1px solid #292E35; border-radius: 11px; cursor: pointer; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #B2BCC6; transition: border-color .2s, color .2s;">
            <span data-copy-label="Copy install command" data-copied="✓ copied to clipboard" data-tone="#B2BCC6">Copy install command</span>
          </button>
        </div>
      </div>
    </section>

    <section id="philosophy" style="position: relative; padding: clamp(84px, 15vh, 160px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; background: #070A0E;">
      <div style="width: min(1120px, 100%); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(34px, 5vw, 70px); align-items: center;">
        <div style="display: flex; flex-direction: column; gap: 20px;">
          {verse.map((v) => (
            <div style={`display: flex; flex-direction: column; gap: 5px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: ${v.range};`}>
              <span style={`font-family: 'Noto Sans Javanese', serif; font-size: clamp(21px, 3.2vw, 34px); line-height: 1.5; color: ${v.tone}; white-space: nowrap;`}>{v.aksara}</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: clamp(10px, 1.3vw, 12px); line-height: 1.5; color: #5D666F;">{v.latin}</span>
            </div>
          ))}
        </div>
        <div>
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C; margin-bottom: 18px; animation: ck-fade linear both; animation-timeline: view(); animation-range: entry 0% entry 65%;">07 — WHY THIS NAME</div>
          <h2 style="margin: 0 0 20px; font-size: clamp(24px, 3.8vw, 38px); font-weight: 700; letter-spacing: -.025em; line-height: 1.16; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 28%;">Loyalty without context is dangerous.</h2>
          <p style="margin: 0 0 16px; font-size: clamp(14.5px, 1.7vw, 16px); line-height: 1.75; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 32%;"><strong style="color: #D2D8DF; font-weight: 600;">Caraka</strong> (ꦕꦫꦏ, Javanese: <em>envoy</em>) is the first word of the Javanese script, from the legend of Aji Saka's two loyal servants.</p>
          <p style="margin: 0 0 20px; font-size: clamp(14.5px, 1.7vw, 16px); line-height: 1.75; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 6% cover 34%;">Both obeyed perfectly. Both were right according to the instructions they held. Both died — killed not by disloyalty, but by two orders that collided, with no way to verify and no human between them at the moment it mattered.</p>
          <a href="/story" style="display: inline-flex; align-items: center; gap: 9px; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #FF7A5E; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 8% cover 36%;">Read the whole story →</a>
        </div>
      </div>
    </section>

    </main>

    <footer style="position: relative; padding: clamp(50px, 8vh, 80px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1120px, 100%); margin: 0 auto; display: flex; flex-wrap: wrap; gap: 26px; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 14px;">
          <div style="position: relative; width: 54px; height: 27px; display: flex; align-items: center; justify-content: center;">
            <div style="position: absolute; left: 50%; top: 50%; width: 26px; height: 26px; margin: -13px 0 0 -26px; border-radius: 50%; border: 1px solid #E2452C;"></div>
            <div style="position: absolute; left: 50%; top: 50%; width: 26px; height: 26px; margin: -13px 0 0 0; border-radius: 50%; border: 1px solid #E2452C;"></div>
            <span style="position: relative; font-family: 'Noto Sans Javanese', serif; font-size: 15px; line-height: 1; display: block; transform: translateY(17.5%); color: #F6F9FC;">ꦕ</span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 3px;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .18em; color: #B2BCC6;">caraka</span>
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: #414950;">MIT · pre-alpha</span>
          </div>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: clamp(14px, 2.6vw, 28px); font-family: 'JetBrains Mono', monospace; font-size: 12.5px;">
          {footerLinks.map((l) => (
            <a href={l.href} class="hv-ink" style="color: #7A848F;">{l.label}</a>
          ))}
        </div>
      </div>
    </footer>

  </div>
</Base>
