---
// Ported from design/mockups/Caraka Story.dc.html. Markup and inline styles are
// transcribed as-is; see site/AGENTS.md for the substitutions that replace the
// design-comp runtime.
import Base from '../layouts/Base.astro'
import SiteHeader from '../components/SiteHeader.astro'
import '../styles/pages/story.css'
import { verse, beats, mapping, markNotes, sisters } from '../data/story'
---

<Base page="story">
  <div style="width: 100%; background: #05080C; font-family: 'Public Sans', sans-serif; color: #E9EDF2; position: relative; overflow-x: hidden;">

    <div aria-hidden="true" style="position: fixed; left: 0; top: 0; right: 0; height: 2px; z-index: 110; background: #171C22;">
      <div style="height: 100%; width: 100%; background: linear-gradient(90deg, #E2452C, #FF7A5E); transform-origin: left; transform: scaleX(var(--ck-sp, 0));"></div>
    </div>

    <SiteHeader badge="STORY" active="/story" />

    <main id="main">

    <section style="position: relative; min-height: 92vh; display: flex; align-items: center; justify-content: center; padding: clamp(110px, 16vh, 170px) clamp(20px, 5vw, 60px) clamp(70px, 10vh, 110px); overflow: hidden;">
      <div aria-hidden="true" style="position: absolute; left: 50%; top: 46%; width: min(760px, 118vw); height: min(760px, 118vw); margin-left: min(-380px, -59vw); margin-top: min(-380px, -59vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.14), transparent 62%); animation: ck-bloom 8s ease-in-out infinite; pointer-events: none;"></div>
      <div style="position: relative; width: min(880px, 100%); display: flex; flex-direction: column; align-items: center; text-align: center; gap: clamp(26px, 4vh, 44px);">
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .26em; color: #E2452C; animation: ck-boot .8s cubic-bezier(.2,.9,.3,1) both;">HANACARAKA</div>
        <div style="display: flex; flex-direction: column; gap: clamp(14px, 2.4vh, 24px); width: 100%;">
          {verse.map((v) => (
            <div style={`display: flex; flex-direction: column; align-items: center; gap: 7px; animation: ck-rise .9s cubic-bezier(.2,.9,.3,1) both; animation-delay: ${v.delay};`}>
              <span style={`font-family: 'Noto Sans Javanese', serif; font-size: clamp(26px, 5.4vw, 56px); line-height: 1.45; color: ${v.tone}; white-space: nowrap;`}>{v.aksara}</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: clamp(10px, 1.5vw, 13px); letter-spacing: .08em; color: #5D666F; text-wrap: balance;">{v.latin}</span>
            </div>
          ))}
        </div>
        <p style="margin: 0; max-width: 560px; font-size: clamp(14.5px, 1.8vw, 17px); line-height: 1.75; color: #7A848F; text-wrap: pretty; animation: ck-fade 1s 1.5s both;">The Javanese script is not an alphabet in the ordinary sense. It is a sentence — a story about two envoys, memorised by every child who learns to write.</p>
        <div aria-hidden="true" style="width: 1px; height: 54px; background: linear-gradient(180deg, #E2452C, transparent); transform-origin: top; animation: ck-drawY .9s cubic-bezier(.3,.7,.3,1) 1.8s both;"></div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(60px, 10vh, 110px) clamp(20px, 5vw, 60px) clamp(84px, 14vh, 150px); border-top: 1px solid #0C1116;">
      <div style="width: min(840px, 100%); margin: 0 auto;">
        <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 75%;">
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">01 — THE LEGEND</span>
          <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
        </div>
        <h2 style="margin: 0 0 clamp(34px, 5vh, 52px); font-size: clamp(26px, 4.6vw, 44px); font-weight: 700; letter-spacing: -.025em; line-height: 1.14; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Two servants. One master. Two instructions that could not both be obeyed.</h2>

        <div style="position: relative; display: flex; flex-direction: column;">
          <div aria-hidden="true" style="position: absolute; left: 19px; top: 24px; bottom: 40px; width: 1px; background: linear-gradient(180deg, #E2452C, #FF93B2); transform-origin: top; animation: ck-drawY linear both; animation-timeline: view(); animation-range: entry 6% cover 62%;"></div>
          {beats.map((b) => (
            <div style={`position: relative; display: flex; gap: clamp(16px, 2.4vw, 24px); padding-bottom: clamp(26px, 4vh, 40px); animation: ck-slideR linear both; animation-timeline: view(); animation-range: ${b.range};`}>
              <span style={`width: 39px; height: 39px; flex-shrink: 0; border-radius: 50%; border: 1px solid ${b.ring}; background: #05080C; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: ${b.ring};`}>{b.n}</span>
              <div style="padding-top: 5px;">
                <div style={`font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .16em; color: ${b.ring}; margin-bottom: 9px;`}>{b.who}</div>
                <p style={`margin: 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.72; color: ${b.ink}; text-wrap: pretty;`}>{b.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div style="margin-top: clamp(20px, 3vh, 34px); padding: clamp(26px, 4vw, 40px); background: #12100F; border: 1px solid #2B1612; border-radius: 16px; text-align: center; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 34%;">
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: .22em; color: #FF7A5E; margin-bottom: 16px;">THE LESSON</div>
          <p style="margin: 0 0 14px; font-size: clamp(19px, 3.2vw, 28px); font-weight: 700; letter-spacing: -.02em; line-height: 1.3; color: #F6F9FC; text-wrap: balance;">Loyalty without context is dangerous.</p>
          <p style="margin: 0 auto; max-width: 520px; font-size: 14.5px; line-height: 1.7; color: #95A0AB; text-wrap: pretty;">Neither envoy betrayed anyone. Both executed faithfully. What killed them was two orders that collided, no way to verify, and no human between them at the moment it mattered.</p>
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(84px, 14vh, 150px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; background: #070A0E;">
      <div style="width: min(1080px, 100%); margin: 0 auto;">
        <div style="max-width: 700px; margin-bottom: clamp(38px, 5vh, 58px);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 75%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">02 — FROM STORY TO ARCHITECTURE</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0 0 16px; font-size: clamp(25px, 4.2vw, 40px); font-weight: 700; letter-spacing: -.025em; line-height: 1.15; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">Every line of the verse is a design decision.</h2>
          <p style="margin: 0; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">This is not decoration applied after the fact. The failure mode in the legend is precisely the failure mode of an autonomous agent with permissions — so the story became the checklist.</p>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          {mapping.map((m) => (
            <div class="hv-ring-soft-row" style={`display: flex; flex-wrap: wrap; gap: clamp(14px, 2.4vw, 30px); align-items: flex-start; padding: clamp(20px, 2.6vw, 28px); background: #0C1116; border: 1px solid #171C22; border-radius: 14px; transition: border-color .25s, background .25s; animation: ck-rise linear both; animation-timeline: view(); animation-range: ${m.range};`}>
              <div style="width: 210px; flex-shrink: 0; display: flex; flex-direction: column; gap: 6px;">
                <span style="font-family: 'Noto Sans Javanese', serif; font-size: 22px; line-height: 1.4; color: #B2BCC6; white-space: nowrap;">{m.aksara}</span>
                <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #5D666F;">{m.latin}</span>
              </div>
              <div style="flex: 1; min-width: 240px; display: flex; flex-direction: column; gap: 7px;">
                <span style="font-size: 16px; font-weight: 600; color: #FF7A5E;">{m.feature}</span>
                <span style="font-size: 14.5px; line-height: 1.65; color: #95A0AB; text-wrap: pretty;">{m.body}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(84px, 14vh, 150px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1080px, 100%); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(34px, 5vw, 66px); align-items: center;">
        <div aria-hidden="true" style="display: flex; align-items: center; justify-content: center; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 32%;">
          <div style="position: relative; width: clamp(220px, 30vw, 300px); height: clamp(220px, 30vw, 300px); display: flex; align-items: center; justify-content: center;">
            <div style="position: absolute; inset: 0; border-radius: 50%; background: repeating-conic-gradient(from 0deg, rgba(226,69,44,.28) 0deg .6deg, transparent .6deg 12deg); animation: ck-spin 44s linear infinite;"></div>
            <div style="position: absolute; inset: 9px; border-radius: 50%; background: #05080C;"></div>
            <div style="position: absolute; inset: 22px; border-radius: 50%; border: 1px solid transparent; border-top-color: #E2452C; animation: ck-spin 7s linear infinite;"></div>
            <div style="position: absolute; inset: 46px; border-radius: 50%; border: 1px dashed rgba(226,69,44,.16); animation: ck-spinRev 22s linear infinite;"></div>
            <div style="position: relative; width: 44%; height: 22%; display: flex; align-items: center; justify-content: center;">
              <div style="position: absolute; left: 50%; top: 50%; width: 100%; height: 200%; margin: -50% 0 0 -100%; border-radius: 50%; border: 1px solid rgba(226,69,44,.5);"></div>
              <div style="position: absolute; left: 50%; top: 50%; width: 100%; height: 200%; margin: -50% 0 0 0; border-radius: 50%; border: 1px solid rgba(226,69,44,.5);"></div>
              <div style="position: absolute; left: 50%; top: 50%; width: 100%; height: 200%; margin: -50% 0 0 -100%; animation: ck-spin 4.2s linear infinite;"><div style="position: absolute; left: 100%; top: 50%; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%; background: #F7FBFF; box-shadow: 0 0 12px 3px rgba(226,69,44,.7);"></div></div>
              <div style="position: absolute; left: 50%; top: 50%; width: 100%; height: 200%; margin: -50% 0 0 0; animation: ck-spinRev 4.2s linear infinite;"><div style="position: absolute; left: 0; top: 50%; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%; background: #F7FBFF; box-shadow: 0 0 12px 3px rgba(226,69,44,.7);"></div></div>
              <span style="position: relative; font-family: 'Noto Sans Javanese', serif; font-size: clamp(42px, 5.8vw, 60px); line-height: 1; display: block; transform: translateY(17.5%); color: #F6F9FC; text-shadow: 0 0 36px rgba(226,69,44,.7);">ꦕ</span>
            </div>
          </div>
        </div>
        <div>
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; animation: ck-slideL linear both; animation-timeline: view(); animation-range: entry 0% entry 75%;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C;">03 — THE MARK</span>
            <span style="flex: 1; height: 1px; background: linear-gradient(90deg, #2B1612, transparent); transform-origin: left; animation: ck-drawX linear both; animation-timeline: view(); animation-range: entry 0% cover 20%;"></span>
          </div>
          <h2 style="margin: 0 0 18px; font-size: clamp(24px, 3.8vw, 38px); font-weight: 700; letter-spacing: -.025em; line-height: 1.16; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 28%;">Two circles. Two envoys. No end.</h2>
          {markNotes.map((p) => (
            <p style={`margin: 0 0 15px; font-size: clamp(14.5px, 1.7vw, 16px); line-height: 1.75; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: ${p.range};`}>{p.t}</p>
          ))}
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(84px, 14vh, 150px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; background: #070A0E;">
      <div style="width: min(880px, 100%); margin: 0 auto; text-align: center;">
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .22em; color: #E2452C; margin-bottom: 20px; animation: ck-fade linear both; animation-timeline: view(); animation-range: entry 0% entry 70%;">04 — A SISTER PROJECT</div>
        <h2 style="margin: 0 0 20px; font-size: clamp(24px, 4vw, 40px); font-weight: 700; letter-spacing: -.025em; line-height: 1.15; color: #F6F9FC; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 26%;">One remembers. One is sent.</h2>
        <p style="margin: 0 auto clamp(34px, 5vh, 46px); max-width: 580px; font-size: clamp(15px, 1.8vw, 17px); line-height: 1.72; color: #95A0AB; text-wrap: pretty; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 30%;">Caraka and <a href="https://titen.dev">Titen</a> are written by the same author. An envoy without memory repeats the same mistakes; memory without an envoy does no work. The legend explains why both must exist together.</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; text-align: left;">
          {sisters.map((s) => (
            <div style={`padding: clamp(24px, 3vw, 32px); background: #0C1116; border: 1px solid ${s.border}; border-radius: 14px; display: flex; flex-direction: column; gap: 11px; animation: ck-rise linear both; animation-timeline: view(); animation-range: ${s.range};`}>
              <span style={`font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .18em; color: ${s.tone};`}>{s.tag}</span>
              <span style="font-size: 20px; font-weight: 700; letter-spacing: -.02em; color: #F6F9FC;">{s.name}</span>
              <span style="font-size: 14px; line-height: 1.65; color: #7A848F; text-wrap: pretty;">{s.body}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="position: relative; padding: clamp(84px, 14vh, 160px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116; overflow: hidden;">
      <div aria-hidden="true" style="position: absolute; left: 50%; top: 50%; width: min(700px, 118vw); height: min(700px, 118vw); margin-left: min(-350px, -59vw); margin-top: min(-350px, -59vw); border-radius: 50%; background: radial-gradient(circle, rgba(226,69,44,.13), transparent 62%); animation: ck-bloom 8s ease-in-out infinite; pointer-events: none;"></div>
      <div style="position: relative; width: min(680px, 100%); margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 24px;">
        <span style="font-family: 'Noto Sans Javanese', serif; font-size: clamp(34px, 6vw, 58px); line-height: 1.4; color: #F6F9FC; text-shadow: 0 0 40px rgba(226,69,44,.5); white-space: nowrap; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 30%;">ꦕꦫꦏ</span>
        <p style="margin: 0; font-size: clamp(16px, 2.2vw, 21px); line-height: 1.6; color: #95A0AB; text-wrap: balance; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 4% cover 32%;">Aji Saka created twenty letters to remember them. We use the first word to make sure the story does not repeat.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; animation: ck-rise linear both; animation-timeline: view(); animation-range: entry 8% cover 34%;">
          <a href="/docs" class="hv-btn" style="padding: 15px 26px; background: #E2452C; border-radius: 11px; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #FFEDE7; transition: background .2s;">Read the docs →</a>
          <a href="/" class="hv-ring-ink" style="padding: 15px 26px; border: 1px solid #292E35; border-radius: 11px; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #B2BCC6; transition: border-color .2s, color .2s;">Back home</a>
        </div>
      </div>
    </section>

    </main>

    <footer style="padding: clamp(44px, 7vh, 70px) clamp(20px, 5vw, 60px); border-top: 1px solid #0C1116;">
      <div style="width: min(1080px, 100%); margin: 0 auto; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #414950;">ꦕ caraka · MIT · v1.5, unproven</span>
        <div style="display: flex; flex-wrap: wrap; gap: clamp(14px, 2.6vw, 28px); font-family: 'JetBrains Mono', monospace; font-size: 12.5px;">
          <a href="/" class="hv-ink" style="color: #7A848F;">Home</a>
          <a href="/docs" class="hv-ink" style="color: #7A848F;">Docs</a>
          <a href="/security" class="hv-ink" style="color: #7A848F;">Security</a>
          <a href="/status" class="hv-ink" style="color: #7A848F;">Status</a>
          <a href="https://github.com/CarakaDev/caraka" class="hv-ink" style="color: #7A848F;">GitHub</a>
          <a href="https://titen.dev" class="hv-ink" style="color: #7A848F;">Titen</a>
        </div>
      </div>
    </footer>

  </div>
</Base>
